# Copia in .env e compila con i valori reali
# Mai committare .env — contiene chiavi private

# Supabase — server-only (senza prefisso VITE_)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...

# Sito
SITE_URL=https://fernsehheute.de

# Cloudflare Pages Deploy Hook
# Crea in: Pages → progetto → Settings → Builds & deployments → Deploy hooks
CLOUDFLARE_DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/xxx

# TMDb (per poster + cast nei programmi)
# Chiave gratuita: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
