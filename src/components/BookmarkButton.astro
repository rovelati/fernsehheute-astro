---
/**
 * BookmarkButton.astro — fernsehheute.de
 * Browser-aware "Zu Favoriten / Lesezeichen hinzufügen" button and instructional modal.
 * Detects Microsoft Edge, Google Chrome, Safari, Firefox, and OS (Windows vs Mac vs Mobile).
 */
---

<!-- Bookmark Trigger Button -->
<button
  id="bookmark-btn"
  type="button"
  aria-label="Zu Favoriten hinzufügen"
  title="Zu Favoriten hinzufügen"
  class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-bold text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/40 border border-amber-200/80 dark:border-amber-800/50 hover:bg-amber-100 dark:hover:bg-amber-900/60 hover:border-amber-300 transition-all shadow-sm select-none cursor-pointer group"
>
  <svg class="w-3.5 h-3.5 text-amber-500 fill-amber-400 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
  </svg>
  <span id="bookmark-btn-label" class="hidden sm:inline">Favoriten</span>
  <span id="bookmark-badge-edge" class="hidden text-[9px] uppercase px-1 py-0.2 bg-blue-600 text-white rounded font-black tracking-wider">Edge</span>
</button>

<!-- Bookmark Modal Dialog -->
<div
  id="bookmark-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-950/60 backdrop-blur-sm transition-opacity"
  role="dialog"
  aria-modal="true"
  aria-labelledby="bookmark-modal-title"
>
  <div class="relative w-full max-w-md bg-white dark:bg-slate-800 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-700 p-6 overflow-hidden transform transition-all text-slate-900 dark:text-slate-100">
    
    <!-- Background glow -->
    <div class="absolute -top-12 -right-12 w-36 h-36 bg-blue-500/10 dark:bg-blue-500/20 rounded-full blur-2xl pointer-events-none"></div>

    <!-- Close button -->
    <button
      id="bookmark-modal-close"
      type="button"
      class="absolute top-4 right-4 p-1.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors"
      aria-label="Schließen"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Header / Icon -->
    <div class="flex items-start gap-4 mb-4">
      <div id="bookmark-browser-icon-container" class="w-12 h-12 rounded-xl flex items-center justify-center bg-blue-50 dark:bg-blue-950/60 text-blue-600 border border-blue-200/60 dark:border-blue-800/40 shrink-0">
        <svg class="w-6 h-6 text-amber-500 fill-amber-400" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
        </svg>
      </div>
      <div>
        <h3 id="bookmark-modal-title" class="text-base font-bold text-slate-900 dark:text-white">
          Zu Favoriten hinzufügen
        </h3>
        <p id="bookmark-modal-subtitle" class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
          Schneller Zugriff auf das aktuelle TV-Programm
        </p>
      </div>
    </div>

    <!-- Instructions Content -->
    <div id="bookmark-instructions" class="my-4 bg-slate-50 dark:bg-slate-900/70 rounded-xl p-4 border border-slate-200/80 dark:border-slate-700/80 space-y-3">
      <div id="bookmark-shortcut-section" class="flex flex-col sm:flex-row items-center justify-between gap-2">
        <span class="text-xs font-medium text-slate-600 dark:text-slate-300">Tastenkombination drücken:</span>
        <div id="bookmark-kbd-keys" class="flex items-center gap-1">
          <kbd class="px-2.5 py-1 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-md text-xs font-mono font-bold text-slate-800 dark:text-slate-200 shadow-sm">Strg</kbd>
          <span class="text-slate-400 font-bold">+</span>
          <kbd class="px-2.5 py-1 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-md text-xs font-mono font-bold text-slate-800 dark:text-slate-200 shadow-sm">D</kbd>
        </div>
      </div>
      <p id="bookmark-desc" class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
        Speichern Sie <strong>FernsehHeute.de</strong> in Ihren Favoriten, um jederzeit mit einem Klick das TV-Programm aufzurufen.
      </p>

      <!-- Edge Sidebar Tip -->
      <div id="bookmark-edge-sidebar-tip" class="hidden pt-2.5 border-t border-slate-200 dark:border-slate-700 text-xs text-blue-700 dark:text-blue-300 flex items-start gap-2">
        <span class="text-sm shrink-0">📌</span>
        <span>
          <strong>Edge-Seitenleiste:</strong> Klicke rechts auf <strong>„+“</strong> in der Edge-Sidebar, um FernsehHeute als permanente Mini-TV-App anzuheften.
        </span>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center justify-between gap-2 pt-2">
      <button
        id="bookmark-install-pwa-btn"
        type="button"
        class="hidden items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-semibold text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-900/30 hover:bg-blue-100 dark:hover:bg-blue-900/50 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span id="bookmark-install-pwa-text">App installieren</span>
      </button>

      <div class="flex items-center gap-2 ml-auto">
        <button
          id="bookmark-copy-link-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors"
        >
          <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span id="bookmark-copy-link-text">Link kopieren</span>
        </button>
        <button
          id="bookmark-confirm-btn"
          type="button"
          class="px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs transition-colors shadow-sm"
        >
          Verstanden
        </button>
      </div>
    </div>

  </div>
</div>

<script>
  (function () {
    const btn = document.getElementById('bookmark-btn');
    const label = document.getElementById('bookmark-btn-label');
    const badgeEdge = document.getElementById('bookmark-badge-edge');
    const modal = document.getElementById('bookmark-modal');
    const closeBtn = document.getElementById('bookmark-modal-close');
    const confirmBtn = document.getElementById('bookmark-confirm-btn');
    const copyBtn = document.getElementById('bookmark-copy-link-btn');
    const copyText = document.getElementById('bookmark-copy-link-text');
    const titleEl = document.getElementById('bookmark-modal-title');
    const kbdContainer = document.getElementById('bookmark-kbd-keys');
    const descEl = document.getElementById('bookmark-desc');
    const shortcutSection = document.getElementById('bookmark-shortcut-section');
    const edgeTip = document.getElementById('bookmark-edge-sidebar-tip');
    const pwaBtn = document.getElementById('bookmark-install-pwa-btn');

    let deferredPrompt: any = null;

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      if (pwaBtn) {
        pwaBtn.classList.remove('hidden');
        pwaBtn.classList.add('inline-flex');
      }
    });

    pwaBtn?.addEventListener('click', async () => {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        const choiceResult = await deferredPrompt.userChoice;
        if (choiceResult.outcome === 'accepted') {
          pwaBtn.classList.add('hidden');
        }
        deferredPrompt = null;
      }
    });

    if (!btn || !modal) return;

    // Detect Browser & OS
    const ua = navigator.userAgent || '';
    const isEdge = /Edg\//i.test(ua);
    const isChrome = /Chrome\//i.test(ua) && !isEdge;
    const isMac = /Macintosh|Mac OS X/i.test(ua);
    const isMobile = /Android|iPhone|iPad|iPod/i.test(ua);

    // Update Header Button Label based on browser
    if (isEdge) {
      if (label) label.textContent = 'Zu Edge-Favoriten';
      if (badgeEdge) badgeEdge.classList.remove('hidden');
      btn.setAttribute('title', 'Zu Microsoft Edge Favoriten hinzufügen (Strg + D)');
    } else if (isChrome) {
      if (label) label.textContent = 'Zu Chrome-Lesezeichen';
      btn.setAttribute('title', 'Zu Google Chrome Lesezeichen hinzufügen (Strg + D)');
    } else if (isMac) {
      if (label) label.textContent = 'Lesezeichen';
      btn.setAttribute('title', 'Zu Lesezeichen hinzufügen (⌘ + D)');
    } else {
      if (label) label.textContent = 'Favoriten';
    }

    // Modal Content Configuration
    function openModal() {
      if (isEdge) {
        if (titleEl) titleEl.textContent = 'Zu Microsoft Edge Favoriten hinzufügen';
        if (edgeTip) edgeTip.classList.remove('hidden');
        if (descEl) {
          descEl.innerHTML = isMac
            ? 'Drücken Sie <strong>⌘ + D</strong>, um <strong>FernsehHeute.de</strong> zu Ihren Edge-Favoriten hinzuzufügen.'
            : 'Drücken Sie <strong>Strg + D</strong> oder klicken Sie auf das <strong>Stern-Symbol ⭐</strong> in der Edge-Adressleiste, um <strong>FernsehHeute.de</strong> zu speichern.';
        }
      } else if (isChrome) {
        if (titleEl) titleEl.textContent = 'Zu Google Chrome Lesezeichen hinzufügen';
        if (descEl) {
          descEl.innerHTML = isMac
            ? 'Drücken Sie <strong>⌘ + D</strong>, um <strong>FernsehHeute.de</strong> zu Ihren Chrome-Lesezeichen hinzuzufügen.'
            : 'Drücken Sie <strong>Strg + D</strong> oder klicken Sie auf den <strong>Stern ⭐</strong> in der Adressleiste, um <strong>FernsehHeute.de</strong> als Lesezeichen zu speichern.';
        }
      } else if (isMobile) {
        if (titleEl) titleEl.textContent = 'FernsehHeute speichern';
        if (shortcutSection) shortcutSection.style.display = 'none';
        if (descEl) {
          descEl.innerHTML = 'Tippen Sie im Menü <strong>(⋮)</strong> oder Teilen-Symbol Ihres Browsers auf <strong>„Zum Startbildschirm hinzufügen“</strong> oder <strong>„Lesezeichen hinzufügen“</strong>.';
        }
      } else {
        if (titleEl) titleEl.textContent = 'Zu Favoriten hinzufügen';
        if (descEl) {
          descEl.innerHTML = isMac
            ? 'Drücken Sie <strong>⌘ + D</strong>, um die Seite zu den Lesezeichen hinzuzufügen.'
            : 'Drücken Sie <strong>Strg + D</strong>, um diese Seite zu Ihren Favoriten hinzuzufügen.';
        }
      }

      // Update KBD symbols for Mac vs Windows
      if (kbdContainer && !isMobile) {
        if (isMac) {
          kbdContainer.innerHTML = `
            <kbd class="px-2.5 py-1 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-md text-xs font-mono font-bold text-slate-800 dark:text-slate-200 shadow-sm">⌘ Cmd</kbd>
            <span class="text-slate-400 font-bold">+</span>
            <kbd class="px-2.5 py-1 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-md text-xs font-mono font-bold text-slate-800 dark:text-slate-200 shadow-sm">D</kbd>
          `;
        } else {
          kbdContainer.innerHTML = `
            <kbd class="px-2.5 py-1 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-md text-xs font-mono font-bold text-slate-800 dark:text-slate-200 shadow-sm">Strg</kbd>
            <span class="text-slate-400 font-bold">+</span>
            <kbd class="px-2.5 py-1 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-600 rounded-md text-xs font-mono font-bold text-slate-800 dark:text-slate-200 shadow-sm">D</kbd>
          `;
        }
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    btn.addEventListener('click', (e) => {
      e.preventDefault();
      openModal();
    });

    closeBtn?.addEventListener('click', closeModal);
    confirmBtn?.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        if (copyText) {
          const orig = copyText.textContent;
          copyText.textContent = '✓ Kopiert!';
          setTimeout(() => {
            copyText.textContent = orig;
          }, 2000);
        }
      } catch (err) {
        // Fallback
      }
    });

  })();
</script>
