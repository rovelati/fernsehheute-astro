---
/**
 * ChannelCard — fernsehheute.de
 * Card di canale con Logo ottimizzato, Nome e Programma Prime Time.
 * Supporta live filtering client-side e responsive desktop grid.
 */
import { formatTime, getPrimeTimeProgram, getEveningProgram, getBerlinMinutes } from '../utils/timeSlots';
import { getChannelLogo } from '../utils/channelLogos';
import type { Channel, Program } from '../types';

interface Props {
  channel: Channel;
  programs: Program[];
  slug: string;
  mode?: 'abend' | 'morgen' | '20-15' | 'jetzt';
}

const { channel, programs, slug, mode = 'abend' } = Astro.props;

// Risolve logo locale ad alta definizione con fallback automatico
const resolvedLogo = getChannelLogo(channel.id, channel.logo, channel.name);

// Programma per la mattina (dopo le 06:00 Berlin)
const morningFirst = programs.find(p => getBerlinMinutes(p.start_time) >= 6 * 60) ?? null;

// Programma live corrente
const nowMs = Date.now();
const liveProgram = programs.find(p => {
  const s = new Date(p.start_time).getTime();
  const e = new Date(p.end_time).getTime();
  return s <= nowMs && nowMs < e;
}) ?? null;

// Programma Prime Time 20:15 (rigoroso: solo programmi in onda alle 20:15 o che iniziano alle 20:15, MAI prima)
const prime2015Program = getPrimeTimeProgram(programs);

// Programma serale per la Homepage "Heute Abend" (fascia serale dalle 18:00 in poi)
const eveningProgram = getEveningProgram(programs);

const displayProgram: Program | null = mode === 'morgen'
  ? (prime2015Program ?? morningFirst ?? programs[0] ?? null)
  : mode === '20-15'
    ? (prime2015Program ?? programs[0] ?? null)
    : mode === 'jetzt'
      ? (liveProgram ?? programs[0] ?? null)
      : (eveningProgram ?? prime2015Program ?? programs[0] ?? null);

const nextProgram = displayProgram
  ? programs.find(p => new Date(p.start_time) >= new Date(displayProgram!.end_time)) ?? null
  : null;

// Category grouping for fast search filter chips
const rawCat = (displayProgram?.category || '').toLowerCase();
let catGroup = 'sonstiges';
if (rawCat.includes('film') || rawCat.includes('kino') || rawCat.includes('thriller') || rawCat.includes('komödie') || rawCat.includes('drama') || rawCat.includes('western')) {
  catGroup = 'film';
} else if (rawCat.includes('serie') || rawCat.includes('sitcom') || rawCat.includes('soap')) {
  catGroup = 'serie';
} else if (rawCat.includes('sport') || rawCat.includes('fussball') || rawCat.includes('fußball') || rawCat.includes('formel')) {
  catGroup = 'sport';
} else if (rawCat.includes('doku') || rawCat.includes('wissen') || rawCat.includes('natur') || rawCat.includes('report')) {
  catGroup = 'doku';
} else if (rawCat.includes('nachrichten') || rawCat.includes('news') || rawCat.includes('magazin') || rawCat.includes('journal')) {
  catGroup = 'news';
} else if (rawCat.includes('show') || rawCat.includes('unterhaltung') || rawCat.includes('quiz') || rawCat.includes('comedy')) {
  catGroup = 'show';
}

// Overlay-JSON per apertura modale con click su programma (compatto)
const overlayJson = displayProgram ? JSON.stringify({
  id:          displayProgram.id,
  title:       displayProgram.title,
  startTime:   displayProgram.start_time,
  endTime:     displayProgram.end_time,
  category:    displayProgram.category   ?? '',
  description: displayProgram.description ? displayProgram.description.slice(0, 240) : '',
  poster_url:  displayProgram.poster_url  ?? null,
  channelId:   slug,
  channelLogo: resolvedLogo,
  channelName: channel.name,
}) : null;
---

<div
  class:list={[
    'channel-card-item block group border-b border-slate-100 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors',
    mode === 'jetzt' && 'jetzt-card',
  ]}
  data-channel-card
  data-channel-name={channel.name.toLowerCase()}
  data-channel-slug={slug}
  data-channel-logo={resolvedLogo}
  data-program-title={displayProgram?.title?.toLowerCase() ?? ''}
  data-category={catGroup}
  data-mode={mode}
>
  <div class="grid grid-cols-[68px_1fr_auto] sm:grid-cols-[84px_1fr_auto] gap-2.5 sm:gap-4 px-3 py-2.5 sm:px-4 sm:py-3 items-center">

    <!-- Spalte links: Logo + Name + Link zum Sendeplan -->
    <a
      href={`/${slug}/`}
      class="flex flex-col items-start gap-1 focus:outline-none z-10 hover:opacity-80 transition-opacity"
      aria-label={`Programmübersicht ${channel.name}`}
    >
      <div class="w-8 h-8 sm:w-9 sm:h-9 flex-shrink-0 flex items-center justify-center overflow-hidden rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-xs p-1 group-hover:scale-105 transition-transform">
        <img
          src={resolvedLogo}
          alt={`Logo ${channel.name}`}
          width="36" height="36"
          class="w-full h-full object-contain"
          loading="lazy"
          onerror="this.style.opacity='0.4';"
        />
      </div>
      <div class="min-w-0 w-full">
        <p class="text-[11px] sm:text-xs font-bold text-slate-900 dark:text-slate-100 leading-tight truncate group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
          {channel.name.replace(/^DE\s*-\s*/i, '')}
        </p>
        {channel.number > 0 && <p class="text-[10px] text-slate-400 dark:text-slate-500">CH {channel.number}</p>}
      </div>
    </a>

    <!-- Spalte mitte: Programm (Öffnet Modal) -->
    <div
      class:list={['min-w-0 py-0.5 cursor-pointer', mode === 'jetzt' && 'jetzt-program-content']}
      role="button"
      tabindex="0"
      title="Klicken für Details"
      data-program={overlayJson}
    >
      {displayProgram ? (
        <div>
          <p class="text-[10px] sm:text-[11px] text-slate-400 dark:text-slate-500 mb-0.5 flex items-center gap-1.5 flex-wrap">
            {mode === 'jetzt' && (
              <span class="inline-flex items-center gap-1 text-[9px] font-black uppercase tracking-wider text-rose-600 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800/60 px-1.5 py-0.5 rounded-full">
                <span class="w-1.5 h-1.5 bg-rose-500 rounded-full animate-pulse inline-block"></span>
                Live
              </span>
            )}
            {mode === '20-15' && (
              <span class="inline-flex items-center gap-1 text-[9px] font-black uppercase tracking-wider text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800/60 px-1.5 py-0.5 rounded-full">
                <span>🌙</span>
                20:15 Prime Time
              </span>
            )}
            {mode === 'abend' && (
              <span class="inline-flex items-center gap-1 text-[9px] font-black uppercase tracking-wider text-blue-700 dark:text-blue-300 bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800/60 px-1.5 py-0.5 rounded-full">
                <span>📺</span>
                Heute Abend
              </span>
            )}
            <span class="tabular-nums font-semibold text-slate-700 dark:text-slate-300">{formatTime(displayProgram.start_time)} – {formatTime(displayProgram.end_time)}</span>
            {displayProgram.category && (
              <span class="uppercase tracking-wide font-semibold text-slate-400 dark:text-slate-500">{displayProgram.category}</span>
            )}
          </p>
          <p class="text-[13px] sm:text-sm font-bold text-slate-900 dark:text-slate-100 leading-snug mb-1.5 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
            {displayProgram.title}
          </p>
          <!-- Fortschrittsbalken -->
          <div class="h-[3px] w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700 mb-1.5">
            <div class="h-full rounded-full bg-slate-300 dark:bg-slate-600" style="width:0%"></div>
          </div>
          {mode === '20-15' && nextProgram && (
            <p class="text-[11px] sm:text-xs text-slate-400 dark:text-slate-500 truncate">
              <span class="text-amber-600/90 dark:text-amber-400/90 font-medium">Danach um <span class="tabular-nums font-semibold">{formatTime(nextProgram.start_time)}</span>:</span>{' '}
              <span class="text-slate-600 dark:text-slate-400">{nextProgram.title}</span>
            </p>
          )}
          {mode === 'abend' && prime2015Program && prime2015Program.id !== displayProgram?.id && (
            <p class="text-[11px] sm:text-xs text-slate-400 dark:text-slate-500 truncate">
              <span class="text-blue-600/90 dark:text-blue-400/90 font-medium">🌙 20:15 Uhr:</span>{' '}
              <span class="text-slate-700 dark:text-slate-300 font-semibold">{prime2015Program.title}</span>
            </p>
          )}
          {mode !== '20-15' && !(mode === 'abend' && prime2015Program && prime2015Program.id !== displayProgram?.id) && nextProgram && (
            <p class="text-[11px] sm:text-xs text-slate-400 dark:text-slate-500 truncate">
              <span class="tabular-nums">{formatTime(nextProgram.start_time)}</span>{' — '}
              <span class="text-slate-600 dark:text-slate-400">{nextProgram.title}</span>
            </p>
          )}
        </div>
      ) : (
        <p class="text-xs text-slate-400 dark:text-slate-500 italic">Kein Programm verfügbar</p>
      )}
    </div>

    <!-- Spalte rechts: Poster & Chevron (Öffnet Modal) -->
    <div
      class:list={[
        'flex items-center gap-2 shrink-0 cursor-pointer',
        mode === 'jetzt' && 'jetzt-right-col',
      ]}
      data-program={overlayJson}
      role="button"
      tabindex="0"
      title={displayProgram ? `${displayProgram.title} — Details ansehen` : undefined}
    >
      <div
        class:list={[
          'w-16 sm:w-24 aspect-video shrink-0 rounded-lg overflow-hidden bg-slate-900 border border-slate-200 dark:border-slate-700/80 shadow-xs cursor-pointer group-hover:scale-105 transition-transform',
          !displayProgram?.poster_url && 'hidden',
          mode === 'jetzt' && 'jetzt-poster-wrap',
        ]}
        role="button"
        tabindex="0"
        title={displayProgram ? `${displayProgram.title} — Details ansehen` : undefined}
      >
        <img
          src={displayProgram?.poster_url ?? ''}
          alt={displayProgram?.title ?? ''}
          width="96"
          height="54"
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          class:list={['w-full h-full object-cover object-top', mode === 'jetzt' && 'jetzt-poster-img']}
          onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=800&q=80';"
        />
      </div>

      <!-- Chevron (nur Desktop) -->
      <div class="hidden sm:flex items-center justify-center pl-1">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="text-slate-300 dark:text-slate-600 group-hover:text-blue-400 transition-colors">
          <path d="M5 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    </div>

  </div>
</div>
