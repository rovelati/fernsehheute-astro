---
/**
 * ChannelCard — fernsehheute.de
 * Kanalzeile mit Logo, Name, Kanal-Nr und Prime-Time-Programm.
 * Entspricht dem Design von 123programmitv.it.
 *
 * mode = 'abend'  → server-side: bestes Abendprogramm (20:15+)
 * mode = 'morgen' → server-side: bestes Programm morgen
 */
import { formatTime } from '../utils/timeSlots';
import type { Channel, Program } from '../types';

interface Props {
  channel: Channel;
  programs: Program[];
  slug: string;
  mode?: 'abend' | 'morgen';
}

const { channel, programs, slug, mode = 'abend' } = Astro.props;

// ─── UTC-Offsets für Berlin (CEST = UTC+2) ────────────────────────────────
const toUTCMin = (t: string) => { const d = new Date(t); return d.getUTCHours() * 60 + d.getUTCMinutes(); };
const PRIME_START   = 18 * 60 + 15; // 20:15 Berlin (UTC+2)
const PRIME_END     = 21 * 60;       // 23:00 Berlin
const EVENING_START = 15 * 60;       // 17:00 Berlin
const MORNING_START =  4 * 60;       // 06:00 Berlin

const primeProgram   = programs.find(p => { const m = toUTCMin(p.start_time); return m >= PRIME_START && m < PRIME_END; }) ?? null;
const eveningProgram = programs.find(p => toUTCMin(p.start_time) >= EVENING_START) ?? null;
const morningFirst   = programs.find(p => toUTCMin(p.start_time) >= MORNING_START) ?? null;

const displayProgram: Program | null = mode === 'morgen'
  ? (primeProgram ?? morningFirst ?? programs[0] ?? null)
  : (primeProgram ?? eveningProgram ?? programs[0] ?? null);

const nextProgram = displayProgram
  ? programs.find(p => new Date(p.start_time) > new Date(displayProgram!.end_time)) ?? null
  : null;

// Overlay-JSON für Klick auf Programm
const overlayJson = displayProgram ? JSON.stringify({
  id:          displayProgram.id,
  title:       displayProgram.title,
  startTime:   displayProgram.start_time,
  endTime:     displayProgram.end_time,
  category:    displayProgram.category   ?? '',
  description: displayProgram.description ?? '',
  poster_url:  displayProgram.poster_url  ?? null,
  cast_json:   (displayProgram as any).cast_json  ?? null,
  channelId:   slug,
  channelLogo: channel.logo,
  channelName: channel.name,
}) : null;
---

<a
  href={`/${slug}`}
  class="block group border-b border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors"
  aria-label={`Alle Sendungen von ${channel.name}`}
>
  <div class="grid grid-cols-[72px_1fr] sm:grid-cols-[88px_1fr_20px] gap-3 px-3 py-2.5 sm:px-4 sm:py-3">

    <!-- Spalte links: Logo + Name + Kanal-Nr -->
    <div class="flex flex-col items-start gap-1.5">
      <div class="w-8 h-8 sm:w-9 sm:h-9 flex-shrink-0 flex items-center justify-center overflow-hidden rounded-lg border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-700 shadow-sm">
        <img
          src={channel.logo}
          alt={`Logo ${channel.name}`}
          width="36" height="36"
          class="w-full h-full object-contain"
          loading="lazy"
          onerror="this.style.display='none'"
        />
      </div>
      <div class="min-w-0 w-full">
        <p class="text-[11px] sm:text-xs font-bold text-slate-900 dark:text-slate-100 leading-tight truncate">{channel.name}</p>
        {channel.number > 0 && <p class="text-[10px] text-slate-400 dark:text-slate-500">CH {channel.number}</p>}
      </div>
    </div>

    <!-- Spalte rechts: Programm -->
    <div class="min-w-0 py-0.5">
      {displayProgram ? (
        <div
          data-program={overlayJson}
          class="cursor-pointer"
          title="Klicken für Details"
          role="button"
          tabindex="0"
        >
          <p class="text-[10px] sm:text-[11px] text-slate-400 dark:text-slate-500 mb-0.5 flex items-center gap-1.5 flex-wrap">
            <span class="tabular-nums">{formatTime(displayProgram.start_time)} – {formatTime(displayProgram.end_time)}</span>
            {displayProgram.category && (
              <span class="uppercase tracking-wide font-semibold">{displayProgram.category}</span>
            )}
          </p>
          <p class="text-[13px] sm:text-sm font-bold text-slate-900 dark:text-slate-100 leading-snug mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
            {displayProgram.title}
          </p>
          <!-- Fortschrittsbalken (immer 0 = zukünftige Sendung) -->
          <div class="h-[3px] w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-600 mb-2">
            <div class="h-full rounded-full bg-slate-300 dark:bg-slate-500" style="width:0%"></div>
          </div>
          {nextProgram && (
            <p class="text-[11px] sm:text-xs text-slate-400 dark:text-slate-500 truncate">
              <span class="tabular-nums">{formatTime(nextProgram.start_time)}</span>{' — '}
              <span class="text-slate-600 dark:text-slate-400">{nextProgram.title}</span>
            </p>
          )}
        </div>
      ) : (
        <p class="text-xs text-slate-400 dark:text-slate-500 italic">Kein Programm verfügbar</p>
      )}
    </div>

    <!-- Chevron (nur Desktop) -->
    <div class="hidden sm:flex items-center justify-center">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="text-slate-300 dark:text-slate-600 group-hover:text-blue-400 transition-colors">
        <path d="M5 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>

  </div>
</a>
