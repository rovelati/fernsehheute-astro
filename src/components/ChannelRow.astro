---
/**
 * ChannelRow — fernsehheute.de
 *
 * Zeigt einen Sender mit seinen Abendsendungen in einer horizontalen Zeile.
 * - Senderlogo links
 * - Sendername + LIVE-Badge (wenn stream_url oder channelStreams.ts)
 * - Bis zu 6 Programmpunkte mit Uhrzeit und Titel
 */
import type { Channel } from '../types';
import { formatTime } from '../utils/timeSlots';
import { getChannelStream } from '../utils/channelStreams';

interface Props {
  channel: Channel;
  /** Normalisierter Slug für die URL (ohne "de-" Präfix) */
  slug: string;
}

const { channel, slug } = Astro.props;
const programs = channel.programs.slice(0, 6);

// Stream-Info: bevorzuge DB-Wert, Fallback auf statische Tabelle
const dbStream = channel.streamUrl;
const staticStream = getChannelStream(slug);
const streamUrl = dbStream ?? staticStream?.url ?? null;
const hasStream = !!streamUrl;
---

<article class="flex items-start gap-3 py-3 px-2 -mx-2 rounded-lg border-b border-zinc-100 dark:border-zinc-800/80 hover:bg-zinc-50 dark:hover:bg-zinc-900/40 transition-colors">

  <!-- Logo -->
  <a href={`/${slug}`} class="shrink-0 flex items-center justify-center w-16 h-10 mt-0.5" tabindex="-1" aria-hidden="true">
    <img
      src={channel.logo}
      alt={`${channel.name} Logo`}
      width="64"
      height="40"
      loading="lazy"
      decoding="async"
      class="max-w-[56px] max-h-[36px] w-auto h-auto object-contain"
      onerror="this.style.display='none'"
    />
  </a>

  <!-- Content -->
  <div class="flex-1 min-w-0">

    <!-- Name row -->
    <div class="flex items-center gap-2 mb-1.5">
      <a
        href={`/${slug}`}
        class="font-semibold text-sm leading-tight hover:text-blue-600 dark:hover:text-blue-400 transition-colors truncate"
      >
        {channel.name}
      </a>

      {hasStream && (
        <a
          href={streamUrl!}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-[10px] font-semibold px-1.5 py-0.5 rounded bg-red-50 dark:bg-red-900/30 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-800/60 hover:bg-red-100 dark:hover:bg-red-900/50 transition-colors whitespace-nowrap"
          title={`${channel.name} live ansehen`}
        >
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse" aria-hidden="true"></span>
          LIVE
        </a>
      )}
    </div>

    <!-- Programs -->
    {programs.length > 0 ? (
      <ul class="flex flex-wrap gap-x-5 gap-y-1" role="list">
        {programs.map((prog, i) => (
          <li class:list={[
            'flex items-baseline gap-1.5 text-sm leading-snug',
            i === 0 ? '' : 'text-zinc-500 dark:text-zinc-400'
          ]}>
            <time
              datetime={prog.start_time}
              class="tabular-nums text-[11px] text-zinc-400 dark:text-zinc-500 shrink-0 font-medium"
            >
              {formatTime(prog.start_time)}
            </time>
            <span class:list={[
              'truncate',
              i === 0 ? 'font-medium text-zinc-800 dark:text-zinc-200 max-w-[22ch]' : 'max-w-[18ch]',
            ]} title={prog.title}>
              {prog.title}
            </span>
            {prog.category && i === 0 && (
              <span class="shrink-0 text-[10px] text-zinc-400 dark:text-zinc-500 font-normal hidden sm:inline">
                {prog.category}
              </span>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-sm text-zinc-400 dark:text-zinc-600 italic">Kein Programm verfügbar</p>
    )}
  </div>
</article>
