---
/**
 * Footer — fernsehheute.de
 */
import { HUB_CHANNELS } from '../utils/hubChannels';

const CATEGORY_LINKS = [
  { href: '/',                    label: 'TV Programm heute Abend'  },
  { href: '/morgen/',             label: 'Programm morgen'          },
  { href: '/film-heute-abend/',   label: 'Filme heute Abend'        },
  { href: '/serien-heute-abend/', label: 'Serien heute Abend'       },
  { href: '/sport-heute-abend/',  label: 'Sport heute Abend'        },
];

const LEGAL_LINKS = [
  { href: '/impressum/',   label: 'Impressum'   },
  { href: '/datenschutz/', label: 'Datenschutz' },
  { href: '/sitemap-index.xml', label: 'Sitemap' },
];
---

<footer class="bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-700 mt-12 text-sm text-slate-500 dark:text-slate-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10">

    <!-- Sender -->
    <div class="mb-8">
      <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-3 text-xs uppercase tracking-wider">TV-Sender</h2>
      <nav class="flex flex-wrap gap-x-4 gap-y-1.5" aria-label="TV-Sender">
        {HUB_CHANNELS.map(ch => (
          <a href={`/${ch.id}/`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
            {ch.name} Programm
          </a>
        ))}
      </nav>
    </div>

    <!-- Kategorien -->
    <div class="mb-8">
      <h2 class="text-slate-900 dark:text-slate-100 font-semibold mb-3 text-xs uppercase tracking-wider">Kategorien</h2>
      <nav class="flex flex-wrap gap-4" aria-label="Programm-Kategorien">
        {CATEGORY_LINKS.map(cat => (
          <a href={cat.href} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
            {cat.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Copyright + Legal -->
    <div class="pt-6 border-t border-slate-200 dark:border-slate-700 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="text-xs text-slate-400 dark:text-slate-500 space-y-1">
        <p>&copy; {new Date().getFullYear()} FernsehHeute.de &mdash; TV Programm Deutschland</p>
        <p>
          Programmdaten: IPTV-EPG.org &mdash;
          Filminfos: <a href="https://www.themoviedb.org" target="_blank" rel="noopener noreferrer" class="underline hover:text-slate-600 dark:hover:text-slate-300">TMDb</a> &mdash;
          Senderlogos &copy; jeweilige Rundfunkanstalten
        </p>
      </div>
      <nav class="flex gap-4 text-xs" aria-label="Rechtliche Links">
        {LEGAL_LINKS.map(link => (
          <a href={link.href} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
            {link.label}
          </a>
        ))}
      </nav>
    </div>

  </div>
</footer>
