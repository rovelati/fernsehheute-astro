---
/**
 * Header — fernsehheute.de
 * Sticky Header mit Logo, Navigation, scrollbarer Senderleiste und Dark-Mode-Toggle.
 * Design: angelehnt an 123programmitv.it
 */
import { HUB_CHANNELS } from '../utils/hubChannels';

const CATEGORY_LINKS = [
  { href: '/film-heute-abend/',   label: 'Filme heute Abend'  },
  { href: '/serien-heute-abend/', label: 'Serien heute Abend' },
  { href: '/sport-heute-abend/',  label: 'Sport heute Abend'  },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHeute  = pathname === '/';
const isMorgen = pathname === '/morgen';
---

<header class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 sticky top-0 z-50 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">

    <!-- Top Bar -->
    <div class="flex items-center justify-between h-16 gap-3">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 select-none group shrink-0" aria-label="FernsehHeute - Startseite">
        <div class="transition-all duration-300 group-hover:scale-105 group-hover:rotate-1">
          <svg class="w-10 h-9 drop-shadow-lg" viewBox="0 0 40 36" fill="none" aria-hidden="true">
            <rect width="40" height="36" rx="6" fill="#2563eb"/>
            <rect x="4" y="4" width="32" height="22" rx="3" fill="#1d4ed8"/>
            <rect x="6" y="6" width="28" height="18" rx="2" fill="#dbeafe"/>
            <polygon points="14,9 14,21 27,15" fill="#2563eb"/>
            <rect x="14" y="28" width="12" height="3" rx="1.5" fill="#2563eb"/>
            <rect x="10" y="31" width="20" height="2" rx="1" fill="#3b82f6"/>
          </svg>
        </div>
        <div class="hidden sm:flex flex-col -space-y-1.5">
          <span class="text-[10px] font-black tracking-[0.3em] text-blue-600 uppercase">Deutschland</span>
          <span class="text-xl font-light tracking-tighter text-slate-800 dark:text-slate-200">
            FERNSEH <span class="font-black text-slate-950 dark:text-white">HEUTE</span>
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 text-sm flex-1 justify-center" aria-label="Hauptnavigation">
        <a href="/" class:list={['px-3 py-1.5 rounded-lg font-semibold transition-colors', isHeute ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800']}>
          Heute Abend
        </a>
        <a href="/morgen/" class:list={['px-3 py-1.5 rounded-lg font-semibold transition-colors', isMorgen ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400' : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800']}>
          Morgen
        </a>
        <span class="w-px h-5 bg-slate-200 dark:bg-slate-700 mx-1" aria-hidden="true"></span>
        {CATEGORY_LINKS.map(cat => (
          <a
            href={cat.href}
            class:list={[
              'px-3 py-1.5 rounded-lg font-semibold transition-colors text-xs',
              Astro.url.pathname === cat.href || pathname === cat.href.replace(/\/$/, '')
                ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400'
                : 'text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-700 dark:hover:text-slate-200'
            ]}
          >
            {cat.label}
          </a>
        ))}
      </nav>

      <!-- Rechts: Mobile Pills + Theme Toggle -->
      <div class="flex items-center gap-2 shrink-0">

        <!-- Mobile: HEUTE / MORGEN -->
        <div class="flex md:hidden items-center gap-0.5 bg-slate-100 dark:bg-slate-800 rounded-full p-1">
          <a href="/" class:list={['px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wide transition-colors whitespace-nowrap', isHeute ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white']}>
            HEUTE
          </a>
          <a href="/morgen/" class:list={['px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wide transition-colors whitespace-nowrap', isMorgen ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white']}>
            MORGEN
          </a>
        </div>

        <!-- Dark/Light Toggle -->
        <button
          id="theme-toggle"
          aria-label="Farbschema wechseln"
          class="w-9 h-9 flex items-center justify-center rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors text-slate-500 dark:text-slate-400"
        >
          <!-- Sonne (dark mode aktiv → klick für hell) -->
          <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
          </svg>
          <!-- Mond (hell → klick für dark) -->
          <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>

      </div>
    </div>

    <!-- Scrollbare Senderleiste -->
    <nav class="flex items-center gap-1 overflow-x-auto py-2 scrollbar-none text-xs border-t border-slate-100 dark:border-slate-700/50" aria-label="Sender">
      {HUB_CHANNELS.map(ch => (
        <a
          href={`/${ch.id}/`}
          class="flex-shrink-0 px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-blue-600 hover:text-white dark:hover:bg-blue-600 transition-colors text-slate-600 dark:text-slate-400 font-medium whitespace-nowrap"
        >
          {ch.name}
        </a>
      ))}
    </nav>

  </div>
</header>

<script>
  function updateIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    document.getElementById('icon-sun')?.classList.toggle('hidden', !isDark);
    document.getElementById('icon-moon')?.classList.toggle('hidden', isDark);
  }

  function toggleTheme() {
    document.documentElement.classList.add('theme-transition');
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateIcons();
    setTimeout(() => document.documentElement.classList.remove('theme-transition'), 300);
  }

  updateIcons();
  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
</script>
