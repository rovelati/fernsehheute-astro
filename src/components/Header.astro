---
/**
 * Header — fernsehheute.de
 * Sticky header mit Logo, Navigation und Dark-Mode-Toggle.
 */
import { formatDateDE } from '../utils/timeSlots';

interface Props {
  today: string;       // YYYY-MM-DD (Europe/Berlin)
  activeSection?: string; // '/', '/morgen', '/film', '/serien', '/sport'
}

const { today, activeSection = '/' } = Astro.props;
const dateLabel = formatDateDE(today);

const navLinks = [
  { href: '/',                   label: 'Heute Abend', key: '/'       },
  { href: '/morgen',             label: 'Morgen',      key: '/morgen' },
  { href: '/film-heute-abend',   label: 'Filme',       key: '/film'   },
  { href: '/serien-heute-abend', label: 'Serien',      key: '/serien' },
  { href: '/sport-heute-abend',  label: 'Sport',       key: '/sport'  },
];
---

<header class="sticky top-0 z-50 border-b border-zinc-200 dark:border-zinc-800 bg-white/95 dark:bg-zinc-950/95 backdrop-blur-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-14 gap-4">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 font-bold text-lg shrink-0 text-zinc-900 dark:text-zinc-100">
        <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M21 3H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h5v2h8v-2h5c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 14H3V5h18v12z"/>
        </svg>
        <span>FernsehHeute</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden sm:flex items-center gap-0.5 text-sm" aria-label="Hauptnavigation">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'px-3 py-1.5 rounded-md transition-colors whitespace-nowrap',
              activeSection === link.key
                ? 'bg-zinc-100 dark:bg-zinc-800 font-semibold'
                : 'text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-zinc-100',
            ]}
            aria-current={activeSection === link.key ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right: date + theme toggle -->
      <div class="flex items-center gap-2 shrink-0">
        <span class="hidden lg:block text-sm text-zinc-500 dark:text-zinc-400">{dateLabel}</span>

        <button
          id="theme-toggle"
          aria-label="Farbschema wechseln"
          class="p-2 rounded-md text-zinc-500 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
        >
          <!-- Moon (shown in light mode) -->
          <svg class="w-4 h-4 dark:hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/>
          </svg>
          <!-- Sun (shown in dark mode) -->
          <svg class="w-4 h-4 hidden dark:block" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0a.996.996 0 0 0 0-1.41l-1.06-1.06zm1.06-12.37l-1.06 1.06a.996.996 0 0 0 0 1.41c.39.39 1.03.39 1.41 0l1.06-1.06a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0zM7.05 18.36l-1.06 1.06a.996.996 0 0 0 0 1.41c.39.39 1.03.39 1.41 0l1.06-1.06a.996.996 0 0 0 0-1.41.996.996 0 0 0-1.41 0z"/>
          </svg>
        </button>

        <!-- Mobile hamburger -->
        <button
          id="mobile-menu-btn"
          aria-label="Menü öffnen"
          class="sm:hidden p-2 rounded-md text-zinc-500 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
          aria-expanded="false"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile nav dropdown -->
    <nav
      id="mobile-menu"
      class="sm:hidden hidden pb-3 pt-1 border-t border-zinc-100 dark:border-zinc-900 mt-0"
      aria-label="Mobile Navigation"
    >
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            'block px-3 py-2 rounded-md text-sm transition-colors',
            activeSection === link.key
              ? 'bg-zinc-100 dark:bg-zinc-800 font-semibold'
              : 'text-zinc-600 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-900',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  // Dark mode toggle
  const themeBtn = document.getElementById('theme-toggle');
  themeBtn?.addEventListener('click', () => {
    const html = document.documentElement;
    html.classList.add('theme-transition');
    html.classList.toggle('dark');
    localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
    window.setTimeout(() => html.classList.remove('theme-transition'), 300);
  });

  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    const open = mobileMenu?.classList.toggle('hidden') === false;
    menuBtn.setAttribute('aria-expanded', String(open));
  });
</script>
