---
/**
 * BaseLayout — fernsehheute.de
 * HTML shell condivisa. Palette slate, ProgramOverlay globale, dark mode flash-free.
 */
import '../styles/global.css';
import ProgramOverlay from '../components/ProgramOverlay.astro';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  jsonLd?: object[];
  noindex?: boolean;
  ogImage?: string;
  keywords?: string;
  author?: string;
}

const { title, description, canonicalUrl, jsonLd, noindex, ogImage, keywords, author } = Astro.props;
const SITE_URL = 'https://fernsehheute.de';
const resolvedCanonical = canonicalUrl ?? new URL(Astro.url.pathname, SITE_URL).href;
const defaultOgImage = `${SITE_URL}/og-default.png`;
---

<!doctype html>
<html lang="de" class="">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />
  <meta name="author" content={author ?? 'FernsehHeute'} />
  <meta name="publisher" content="FernsehHeute" />
  <link rel="canonical" href={resolvedCanonical} />

  <!-- Language & Geotargeting (Germany & DACH Region) -->
  <meta name="content-language" content="de-DE" />
  <meta name="language" content="German" />
  <meta name="geo.region" content="DE" />
  <meta name="geo.placename" content="Deutschland" />
  <meta name="geo.position" content="51.165691;10.451526" />
  <meta name="ICBM" content="51.165691, 10.451526" />

  <!-- Hreflang Canonical & Regional Alternates -->
  <link rel="alternate" hreflang="de-DE" href={resolvedCanonical} />
  <link rel="alternate" hreflang="de-AT" href={resolvedCanonical} />
  <link rel="alternate" hreflang="de-CH" href={resolvedCanonical} />
  <link rel="alternate" hreflang="x-default" href={resolvedCanonical} />

  <!-- Microsoft Edge, Windows & PWA Compatibility -->
  <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
  <meta name="application-name" content="FernsehHeute" />
  <meta name="msapplication-TileColor" content="#2563eb" />
  <meta name="msapplication-config" content="/browserconfig.xml" />
  <meta name="msapplication-tap-highlight" content="no" />
  <meta name="msvalidate.01" content="F5DABCFE31DB618797D7F6B92B67C3F1" />
  <link rel="manifest" href="/manifest.webmanifest" />

  <!-- RSS / Microsoft Start Feed -->
  <link rel="alternate" type="application/rss+xml" title="FernsehHeute — TV Highlights heute Abend" href="https://fernsehheute.de/feed/heute-abend.xml" />

  <!-- Google Analytics (GA4) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-FEQCS4CCVP"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-FEQCS4CCVP');
  </script>

  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={resolvedCanonical} />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:image" content={ogImage ?? defaultOgImage} />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:locale:alternate" content="de_AT" />
  <meta property="og:locale:alternate" content="de_CH" />
  <meta property="og:site_name" content="FernsehHeute" />

  <!-- Twitter / Edge Feed Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={ogImage ?? defaultOgImage} />

  <!-- JSON-LD -->
  {jsonLd?.map(schema => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <!-- Dark mode init: kein Flash -->
  <script is:inline>
    (function () {
      try {
        var s = localStorage.getItem('theme');
        var d = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (s === 'dark' || (!s && d)) document.documentElement.classList.add('dark');
      } catch (e) {}
    })();
  </script>

  <!-- Live updater: date display + "Läuft" badges (runs client-side, updates every 60s) -->
  <script is:inline>
    (function () {
      var DATE_FMT = new Intl.DateTimeFormat('de-DE', {
        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric',
        timeZone: 'Europe/Berlin',
      });

      function update() {
        var now = Date.now();

        // ── Date display ─────────────────────────────────────────────────────
        var todayStr = DATE_FMT.format(new Date(now));
        var dateEls = document.querySelectorAll('[data-live-date]');
        for (var i = 0; i < dateEls.length; i++) {
          dateEls[i].textContent = todayStr;
        }
        var tomorrowDate = new Date(now + 86400000);
        var tomorrowStr = DATE_FMT.format(tomorrowDate);
        var dateTomEls = document.querySelectorAll('[data-live-date-tomorrow]');
        for (var i = 0; i < dateTomEls.length; i++) {
          dateTomEls[i].textContent = tomorrowStr;
        }

        // ── Live badges on ProgramRow ─────────────────────────────────────────
        var rows = document.querySelectorAll('[data-program]');
        for (var j = 0; j < rows.length; j++) {
          var row = rows[j];
          try {
            var d = JSON.parse(row.getAttribute('data-program'));
            var start = new Date(d.startTime).getTime();
            var end   = new Date(d.endTime).getTime();
            var live  = start <= now && now < end;

            // Badge element
            var badge = row.querySelector('.live-badge');
            if (badge) {
              badge.style.display = live ? '' : 'none';
            }

            // Row background highlight
            if (live) {
              row.classList.add('bg-blue-50/50', 'dark:bg-blue-900/10');
            } else {
              row.classList.remove('bg-blue-50/50', 'dark:bg-blue-900/10');
            }
          } catch (e) {}
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', update);
      } else {
        update();
      }
      setInterval(update, 60000);
    })();
  </script>
</head>
<body class="bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 min-h-screen antialiased">
  <slot />
  <ProgramOverlay />
</body>
</html>
