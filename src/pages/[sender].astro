---
/**
 * /[sender] — Senderprogramm-Seite (z.B. /zdf, /rtl, /das-erste)
 *
 * Struktur angelehnt an 123programmitv.it:
 * - Hero Section: großes Logo, Sender, Datum, Live-Button
 * - Programm-Sektionen: Prime Time (orange), Abend, Nachmittag, Vormittag, Nacht
 * - ProgramRow mit Overlay-Klick, Kategorie-Badges, Poster
 * - Internal Links zu anderen Sendern
 * - SEO: Datum im Titel, Keywords, JSON-LD
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProgramRow from '../components/ProgramRow.astro';
import AdSlot from '../components/AdSlot.astro';
import { ADSENSE_SLOTS } from '../lib/adsense';
import { fetchChannels, fetchProgramsForDate, fetchTmdbEnrichment } from '../lib/epg';
import { getChannelLogo } from '../utils/channelLogos';
import { getTodayInBerlin, formatDateDE, getBerlinHour } from '../utils/timeSlots';
import { buildHubChannelJsonLd, buildFaqJsonLd } from '../utils/jsonld';
import { getChannelStream } from '../utils/channelStreams';
import { HUB_CHANNELS } from '../utils/hubChannels';
import { normCid } from '../utils/channelSlug';
import { isAdultChannel, isTestChannel, filterRealPrograms, isClubChannel } from '../utils/channelFilters';
import type { Channel, Program } from '../types';
import type { ProgramEnrichment } from '../lib/epg';

export async function getStaticPaths() {
  const normCidLocal = normCid;

  const today = getTodayInBerlin();
  const [channels, allPrograms] = await Promise.all([
    fetchChannels(),
    fetchProgramsForDate(today),
  ]);

  const programsByChannel = new Map<string, Program[]>();
  for (const prog of allPrograms) {
    const key = normCidLocal(prog.channel_id ?? '');
    if (!programsByChannel.has(key)) programsByChannel.set(key, []);
    programsByChannel.get(key)!.push(prog);
  }
  for (const arr of programsByChannel.values()) {
    arr.sort((a, b) => new Date(a.start_time).getTime() - new Date(b.start_time).getTime());
  }

  // TMDB enrichment
  const allProgramIds = [...programsByChannel.values()].flat().map(p => p.id);
  const enrichmentMap = await fetchTmdbEnrichment(allProgramIds)
    .catch(() => new Map<string, ProgramEnrichment>());

  for (const [, progs] of programsByChannel) {
    for (const prog of progs) {
      const enrich = enrichmentMap.get(String(prog.id));
      if (enrich) {
        if (enrich.poster_url && !prog.poster_url) prog.poster_url = enrich.poster_url;
        if (enrich.synopsis   && !prog.description) prog.description = enrich.synopsis;
        if (enrich.cast_json)    (prog as any).cast_json    = enrich.cast_json;
        if (enrich.release_year) (prog as any).release_year = enrich.release_year;
        if (enrich.runtime_min)  (prog as any).runtime_min  = enrich.runtime_min;
      }
    }
  }

  const paths = channels
    .filter(ch => {
      const slug = normCidLocal(ch.id);
      if (isAdultChannel(slug, ch.name) || isTestChannel(slug, ch.name)) return false;
      return true;
    })
    .map(ch => {
      const slug = normCidLocal(ch.id);
      const progs = programsByChannel.get(slug) ?? [];
      const realProgs = filterRealPrograms(progs);
      return {
        params: { sender: slug },
        props: { channel: { ...ch, programs: realProgs } as Channel, today, slug },
      };
    });

  // Write slugs with no EPG so sitemap and IndexNow can exclude them
  try {
    const { writeFileSync, mkdirSync } = await import('node:fs');
    const { resolve } = await import('node:path');
    const emptySlugs = paths
      .filter(p => (p.props.channel.programs ?? []).length === 0)
      .map(p => p.params.sender);
    const outDir = resolve(process.cwd(), '.astro');
    mkdirSync(outDir, { recursive: true });
    writeFileSync(resolve(outDir, 'empty-channels.json'), JSON.stringify(emptySlugs));
  } catch (e) {
    console.warn('[getStaticPaths] Could not write empty-channels.json:', e);
  }

  return paths;
}

interface Props { channel: Channel; today: string; slug: string; }
const { channel, today, slug } = Astro.props;

// Risolve logo locale ad alta definizione con fallback SVG
const resolvedLogo = getChannelLogo(channel.id, channel.logo, channel.name);
const initials = ((channel.name || slug).replace(/^DE\s*-\s*/i, '').trim().slice(0, 3) || 'TV').toUpperCase();
const fallbackDataUri = `data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='16' fill='%231e293b'/><text x='50%' y='54%' dominant-baseline='middle' text-anchor='middle' fill='%2338bdf8' font-family='system-ui,sans-serif' font-weight='900' font-size='28'>${initials}</text></svg>`;

type ExtProgram = Program & {
  cast_json?:    { name: string; role: string; character?: string }[];
  release_year?: number;
  runtime_min?:  number;
};

const programs = (channel.programs ?? []) as ExtProgram[];
const dateLabel = formatDateDE(today);

// Stream
const staticStream = getChannelStream(slug);
const streamUrl    = channel.streamUrl ?? staticStream?.url ?? null;
const streamLabel  = staticStream?.label ?? channel.name;

// ── Zeit-Sektionen (Berlin) ────────────────────────────────────────────────
// UTC-Minuten (CEST = Berlin UTC+2)
const toUTCMin = (t: string) => { const d = new Date(t); return d.getUTCHours() * 60 + d.getUTCMinutes(); };
const PRIME_START =  18 * 60 + 15; // 20:15 Berlin
const PRIME_END   =  21 * 60;      // 23:00 Berlin
const NOON_UTC    =  10 * 60;      // 12:00 Berlin
const AFTNOON_UTC =  15 * 60;      // 17:00 Berlin

const sectionVormittag  = programs.filter(p => toUTCMin(p.start_time) < NOON_UTC);
const sectionNachmittag = programs.filter(p => { const m = toUTCMin(p.start_time); return m >= NOON_UTC && m < AFTNOON_UTC; });
const sectionAbend      = programs.filter(p => { const m = toUTCMin(p.start_time); return m >= AFTNOON_UTC && m < PRIME_START; });
const sectionPrimeTime  = programs.filter(p => { const m = toUTCMin(p.start_time); return m >= PRIME_START && m < PRIME_END; });
const sectionNacht      = programs.filter(p => toUTCMin(p.start_time) >= PRIME_END);

// ── SEO ───────────────────────────────────────────────────────────────────
const cleanName   = channel.name.replace(/^DE\s*-\s*/i, '').trim();
const pageTitle   = `${cleanName} Programm heute & heute Abend – TV-Programm`;
const description = `Aktuelles ${cleanName} Programm von heute: alle Sendungen, Spielfilme & Serien ab 20:15 Uhr auf ${cleanName} im TV-Programm mit genauen Sendezeiten und Mediathek-Infos.`;
const keywords    = `${cleanName.toLowerCase()} programm heute, ${cleanName.toLowerCase()} heute, ${cleanName.toLowerCase()} programm heute abend, ${cleanName.toLowerCase()} heute abend, ${cleanName.toLowerCase()} programm, was läuft heute auf ${cleanName.toLowerCase()}, ${cleanName.toLowerCase()} sendeplan, ${cleanName.toLowerCase()} fernsehprogramm`;
const canonicalUrl = `https://fernsehheute.de/${slug}/`;
const ogImage      = resolvedLogo.startsWith('http') || resolvedLogo.startsWith('/') ? resolvedLogo : undefined;

const isClub = isClubChannel(slug, channel.name);

const defaultFaqs = [
  {
    question: `Was läuft heute auf ${cleanName}?`,
    answer: `Hier findest du das vollständige heutige Fernsehprogramm von ${cleanName} mit allen Sendungen, Spielfilmen, Serien und Magazinen im Tages- und Abendverlauf inklusive genauer Beginnzeiten.`,
  },
  {
    question: `Wann beginnt das Hauptabendprogramm (Prime Time) auf ${cleanName}?`,
    answer: `Das Hauptabendprogramm auf ${cleanName} startet regulär um 20:15 Uhr mit den besten Filmen, Shows oder Serien des Tages.`,
  },
  {
    question: `Wo kann man ${cleanName} live im Internet streamen?`,
    answer: streamUrl
      ? `${cleanName} kann online über den offiziellen Livestream bzw. die Mediathek geschaut werden.`
      : `Sendungen von ${cleanName} sind in den offiziellen Mediatheken und Streaming-Angeboten des Senders abrufbar.`,
  },
];

const clubFaqs = [
  {
    question: `Wo kann man die Spiele von ${cleanName} heute live im Fernsehen sehen?`,
    answer: `Die offiziellen Ligaspiele von ${cleanName} in der Fußball-Bundesliga werden in Deutschland live bei DAZN (alle Sonntags- und Freitagsspiele) sowie Sky Sport Bundesliga (alle Samstagsspiele und die Konferenz) übertragen. Zusammenfassungen gibt es am Sonntagabend in der ARD Sportschau.`,
  },
  {
    question: `Warum zeigt der Vereinskanal von ${cleanName} heute keine Live-Spiele?`,
    answer: `Offizielle Club-Kanäle wie ${cleanName} sind reine Event- und Informationssender für Testspiele, Club-Reportagen und Pressekonferenzen. Aus rechtlichen Gründen besitzen sie keine Live-Rechte für reguläre Bundesliga- und Champions-League-Spiele.`,
  },
  {
    question: `Wo finde ich das heutige Fußball- und Sportprogramm?`,
    answer: `Alle heutigen Live-Spiele, Sendezeiten und übertragenden TV-Sender (Sky, DAZN, Free-TV) findest du in unserer tagesaktuellen Übersicht unter /sport-heute-abend/.`,
  },
];

const channelFaqs = isClub ? clubFaqs : defaultFaqs;

const channelSchemas = buildHubChannelJsonLd({ channel: { ...channel, name: cleanName, logo: resolvedLogo }, programs, today });
const faqSchema      = buildFaqJsonLd(channelFaqs);
const jsonLd         = [...channelSchemas, faqSchema];

// Andere Sender für Internal Links
const otherChannels = HUB_CHANNELS.filter(c => c.id !== slug).slice(0, 12);
---

<BaseLayout
  title={`${pageTitle} | FernsehHeute`}
  {description}
  {keywords}
  {canonicalUrl}
  {jsonLd}
  {ogImage}
>
  <Header />

  <!-- ── Breadcrumb ──────────────────────────────────────────────────────── -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-3">
    <nav class="flex items-center gap-1.5 text-xs text-slate-400 dark:text-slate-500" aria-label="Breadcrumb">
      <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Fernsehprogramm heute</a>
      <span aria-hidden="true">›</span>
      <span class="text-slate-600 dark:text-slate-300 font-medium">{cleanName}</span>
    </nav>
  </div>

  <!-- ── Hero Section ───────────────────────────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-6 border-b border-slate-100 dark:border-slate-700/50">
    <div class="flex items-center gap-4 mb-3">
      <!-- Logo -->
      <div class="w-16 h-16 flex-shrink-0 bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden flex items-center justify-center shadow-sm p-2">
        <img
          src={resolvedLogo}
          alt={`Logo ${cleanName}`}
          width="56" height="56"
          class="w-14 h-14 object-contain"
          loading="eager"
          onerror={`this.onerror=null; this.src='${fallbackDataUri}';`}
        />
      </div>
      <!-- Name + Datum -->
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight">
          <span class="text-blue-600 dark:text-blue-400">{cleanName}</span> Programm heute &amp; heute Abend
        </h1>
        <p class="text-slate-500 dark:text-slate-400 text-sm mt-1"><span data-live-date>{dateLabel}</span></p>
      </div>
    </div>

    <p class="text-slate-500 dark:text-slate-400 text-sm mb-4">
      Vollständiger Sendeplan für {cleanName} heute: alle Sendungen mit Uhrzeit, Beschreibung und Details ab 20:15 Uhr.
    </p>

    {isClub && (
      <div class="mb-5 rounded-2xl border border-amber-200 dark:border-amber-900/60 bg-gradient-to-r from-amber-50 to-orange-50 dark:from-amber-950/40 dark:to-orange-950/30 p-4 sm:p-5 shadow-xs">
        <div class="flex items-start gap-3 sm:gap-4">
          <div class="p-2 sm:p-2.5 rounded-xl bg-amber-500/15 text-amber-600 dark:text-amber-400 shrink-0 text-xl">
            ⚽
          </div>
          <div class="flex-1 min-w-0">
            <h2 class="text-sm sm:text-base font-bold text-slate-900 dark:text-slate-100 mb-1">
              Hinweis zu Vereinskanälen &amp; Bundesliga-Übertragungen
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-3">
              Offizielle Club-Sender wie <strong>{cleanName}</strong> sind reine Event- und Audio-Kanäle für Pressekonferenzen und Sonderübertragungen. Die offiziellen Ligaspiele der Bundesliga laufen live auf <strong>DAZN</strong> (Freitag &amp; Sonntag) sowie <strong>Sky Sport Bundesliga</strong> (Samstag &amp; Konferenz).
            </p>
            <div class="flex flex-wrap items-center gap-2 pt-0.5">
              <a
                href="/sport-heute-abend/"
                class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 transition-colors shadow-xs"
              >
                <span>🏆 Alle Live-Spiele &amp; Sport heute Abend</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
              </a>
              <a
                href="/sky-sport-bundesliga/"
                class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors"
              >
                Sky Sport Bundesliga
              </a>
              <a
                href="/dazn1/"
                class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors"
              >
                DAZN 1
              </a>
            </div>
          </div>
        </div>
      </div>
    )}

    <div class="flex flex-wrap gap-2">
      <!-- Live-Stream Button -->
      {streamUrl && (
        <a
          href={streamUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-bold rounded-xl transition-colors shadow-sm"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="5,3 19,12 5,21"/></svg>
          Live ansehen
          <span class="text-red-200 font-normal text-xs">· {streamLabel}</span>
        </a>
      )}
      <!-- Quick Links -->
      <a href="/" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 text-xs font-semibold transition-colors">
        ← Alle Sender
      </a>
      <a href="/sport-heute-abend/" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-amber-50 dark:bg-amber-900/20 text-amber-700 dark:text-amber-300 hover:bg-amber-100 dark:hover:bg-amber-900/40 text-xs font-semibold transition-colors border border-amber-200 dark:border-amber-800/40">
        ⚽ Fußball &amp; Sport heute
      </a>
      <a href="/film-heute-abend/" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-purple-50 dark:bg-purple-900/20 text-purple-700 dark:text-purple-300 hover:bg-purple-100 dark:hover:bg-purple-900/40 text-xs font-semibold transition-colors border border-purple-200 dark:border-purple-800/40">
        🎬 Filme heute Abend
      </a>
      <a href="/morgen/" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 text-xs font-semibold transition-colors">
        Programm morgen →
      </a>
    </div>
  </section>

  <!-- ── Programmliste ──────────────────────────────────────────────────── -->
  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 py-6 pb-12">

    {programs.length === 0 ? (
      isClub ? (
        <div class="max-w-2xl mx-auto text-center py-12 px-6 bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm my-6">
          <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200/60 dark:border-amber-800/60 flex items-center justify-center text-3xl shadow-inner">
            ⚽
          </div>
          <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-2">
            Keine Live-Übertragung auf {cleanName} heute
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-400 max-w-md mx-auto mb-6 leading-relaxed">
            Auf diesem Vereinskanal findet heute kein reguläres Live-Spiel statt. Die heutigen Bundesliga-Begegnungen des Spieltags sowie alle Zusammenfassungen siehst du live auf Sky, DAZN und in der ARD Sportschau.
          </p>
          <div class="flex flex-wrap justify-center gap-3 mb-6">
            <a
              href="/sport-heute-abend/"
              class="inline-flex items-center gap-2 px-5 py-3 bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold rounded-2xl transition-all shadow-md shadow-blue-500/20"
            >
              Zum heutigen Fußball- &amp; Sportprogramm &rarr;
            </a>
            <a
              href="/sky-sport-bundesliga/"
              class="inline-flex items-center gap-2 px-5 py-3 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 text-sm font-semibold rounded-2xl transition-colors border border-slate-200 dark:border-slate-700"
            >
              Sky Sport Bundesliga
            </a>
          </div>
          <div class="border-t border-slate-100 dark:border-slate-800 pt-6">
            <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-3">
              Wichtige Sport- &amp; TV-Sender heute
            </p>
            <div class="flex flex-wrap justify-center gap-2">
              {[
                { id: 'sky-sport-bundesliga', name: 'Sky Sport Bundesliga' },
                { id: 'dazn1', name: 'DAZN 1' },
                { id: 'sport1', name: 'SPORT1' },
                { id: 'das-erste', name: 'Das Erste (Sportschau)' },
                { id: 'zdf', name: 'ZDF (Sportstudio)' },
              ].map(ch => (
                <a
                  href={`/${ch.id}/`}
                  class="px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 hover:bg-blue-600 hover:text-white dark:hover:bg-blue-600 text-slate-700 dark:text-slate-300 text-xs font-semibold border border-slate-200/60 dark:border-slate-700 transition-colors"
                >
                  {ch.name}
                </a>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <div class="max-w-2xl mx-auto text-center py-14 px-6 bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/80 dark:border-slate-800 shadow-sm my-6">
          <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-3xl shadow-inner">
            📺
          </div>
          <h2 class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-2">
            Keine Sendedaten für {channel.name.replace(/^DE\s*-\s*/i, '')} heute
          </h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto mb-6 leading-relaxed">
            Für diesen Sender liegt für heute kein elektronischer EPG-Sendeplan vor. Du kannst den Sender online im Live-Stream ansehen oder das Hauptabendprogramm beliebter deutscher Sender durchstöbern.
          </p>

          {streamUrl && (
            <div class="mb-8">
              <a
                href={streamUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-3 bg-red-600 hover:bg-red-700 text-white text-sm font-bold rounded-2xl transition-all shadow-md shadow-red-500/20"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg>
                Offiziellen Live-Stream öffnen
              </a>
            </div>
          )}

          <div class="border-t border-slate-100 dark:border-slate-800 pt-6">
            <p class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-4">
              Beliebte TV-Sender heute Abend
            </p>
            <div class="flex flex-wrap justify-center gap-2">
              {[
                { id: 'das-erste', name: 'Das Erste' },
                { id: 'zdf', name: 'ZDF' },
                { id: 'rtl', name: 'RTL' },
                { id: 'sat1', name: 'SAT.1' },
                { id: 'prosieben', name: 'ProSieben' },
                { id: 'vox', name: 'VOX' },
                { id: 'kabel-eins', name: 'Kabel Eins' },
                { id: 'arte', name: 'Arte' },
                { id: '3sat', name: '3sat' },
              ].map(ch => (
                <a
                  href={`/${ch.id}/`}
                  class="px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 hover:bg-blue-600 hover:text-white dark:hover:bg-blue-600 text-slate-700 dark:text-slate-300 text-xs font-semibold border border-slate-200/60 dark:border-slate-700 transition-colors"
                >
                  {ch.name}
                </a>
              ))}
            </div>
          </div>
        </div>
      )
    ) : (
      <div class="rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden bg-white dark:bg-slate-800/50 shadow-sm">

        {/* ── Prime Time (orange) ── */}
        {sectionPrimeTime.length > 0 && (
          <section aria-label="Prime Time">
            <h2 class="text-[11px] font-bold uppercase tracking-widest text-orange-600 dark:text-orange-400 px-4 py-2.5 bg-orange-50 dark:bg-orange-900/20 border-b border-orange-100 dark:border-orange-800/30 flex items-center gap-1.5">
              <span class="w-2 h-2 bg-orange-500 rounded-full inline-block" aria-hidden="true"></span>
              Prime Time · ab 20:15 Uhr
            </h2>
            <ul role="list" class="divide-y divide-slate-100 dark:divide-slate-700/50">
              {sectionPrimeTime.map(prog => (
                <ProgramRow program={prog} channelId={slug} channelLogo={resolvedLogo} channelName={channel.name} />
              ))}
            </ul>
          </section>
        )}

        {/* ── Abend ── */}
        {sectionAbend.length > 0 && (
          <section aria-label="Abend">
            <h2 class="text-[11px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 px-4 py-2 bg-slate-50 dark:bg-slate-800/30 border-b border-slate-100 dark:border-slate-700/50">
              Abend · 17:00 – 20:15 Uhr
            </h2>
            <ul role="list" class="divide-y divide-slate-100 dark:divide-slate-700/50">
              {sectionAbend.map(prog => (
                <ProgramRow program={prog} channelId={slug} channelLogo={resolvedLogo} channelName={channel.name} />
              ))}
            </ul>
          </section>
        )}

        {/* ── UX-First Mid-Content AdSlot (nach Prime Time & Vorabend) ── */}
        {(sectionPrimeTime.length > 0 || sectionAbend.length > 0) && (
          <div class="p-3 bg-slate-50/40 dark:bg-slate-900/40 border-b border-slate-100 dark:border-slate-700/50">
            <AdSlot slot={ADSENSE_SLOTS.SENDER_MID_CONTENT} className="my-1" minHeight={180} />
          </div>
        )}

        {/* ── Nacht ── */}
        {sectionNacht.length > 0 && (
          <section aria-label="Nacht">
            <h2 class="text-[11px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 px-4 py-2 bg-slate-50 dark:bg-slate-800/30 border-b border-slate-100 dark:border-slate-700/50">
              Nacht · ab 23:00 Uhr
            </h2>
            <ul role="list" class="divide-y divide-slate-100 dark:divide-slate-700/50">
              {sectionNacht.map(prog => (
                <ProgramRow program={prog} channelId={slug} channelLogo={resolvedLogo} channelName={channel.name} />
              ))}
            </ul>
          </section>
        )}

        {/* ── Nachmittag ── */}
        {sectionNachmittag.length > 0 && (
          <section aria-label="Nachmittag">
            <h2 class="text-[11px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 px-4 py-2 bg-slate-50 dark:bg-slate-800/30 border-b border-slate-100 dark:border-slate-700/50">
              Nachmittag · 12:00 – 17:00 Uhr
            </h2>
            <ul role="list" class="divide-y divide-slate-100 dark:divide-slate-700/50">
              {sectionNachmittag.map(prog => (
                <ProgramRow program={prog} channelId={slug} channelLogo={resolvedLogo} channelName={channel.name} />
              ))}
            </ul>
          </section>
        )}

        {/* ── Vormittag ── */}
        {sectionVormittag.length > 0 && (
          <section aria-label="Vormittag">
            <h2 class="text-[11px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 px-4 py-2 bg-slate-50 dark:bg-slate-800/30 border-b border-slate-100 dark:border-slate-700/50">
              Vormittag · bis 12:00 Uhr
            </h2>
            <ul role="list" class="divide-y divide-slate-100 dark:divide-slate-700/50">
              {sectionVormittag.map(prog => (
                <ProgramRow program={prog} channelId={slug} channelLogo={resolvedLogo} channelName={channel.name} />
              ))}
            </ul>
          </section>
        )}

      </div>
    )}

    <!-- ── UX-First Footer AdSlot vor den FAQs ──────────────────────── -->
    <AdSlot slot={ADSENSE_SLOTS.CONTENT_FOOTER_FAQ} className="mt-8 mb-2" minHeight={200} />

    <!-- ── Channel FAQs ─────────────────────────────────────────────── -->
    <section class="mt-8 pt-6 border-t border-slate-200 dark:border-slate-800" aria-label={`Häufige Fragen zu ${channel.name}`}>
      <h2 class="text-lg font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-4">
        Häufige Fragen zum {channel.name} Programm heute
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {channelFaqs.map(faq => (
          <div class="bg-slate-50 dark:bg-slate-800/40 border border-slate-200/80 dark:border-slate-700/60 rounded-xl p-4">
            <h3 class="font-semibold text-slate-900 dark:text-slate-100 mb-1.5 text-sm">
              {faq.question}
            </h3>
            <p class="text-slate-600 dark:text-slate-400 text-xs leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Internal Links ──────────────────────────────────────────────── -->
    <div class="mt-8 p-4 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
      <p class="text-sm text-slate-500 dark:text-slate-400 mb-3 font-medium">Weitere Sender:</p>
      <nav class="flex flex-wrap gap-x-4 gap-y-2 text-sm" aria-label="Andere TV-Sender">
        {otherChannels.map(ch => (
          <a href={`/${ch.id}/`} class="text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 hover:underline transition-colors">
            {ch.name} Programm heute
          </a>
        ))}
        <a href="/" class="text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 hover:underline transition-colors font-semibold">
          Alle Sender heute Abend →
        </a>
      </nav>
    </div>

  </main>

  <Footer />
</BaseLayout>
