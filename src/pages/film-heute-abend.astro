---
/**
 * /film-heute-abend — Filme heute Abend im TV
 *
 * Alle Spielfilme heute Abend auf deutschen Sendern.
 * Genre-Erkennung: keywords im genre-Feld ("Film", "Spielfilm", "Kino", "Movie")
 *   + Titel-Klammern wie "Filmname (2023)"
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInBerlin, formatDateDE, formatTime, getBerlinHour } from '../utils/timeSlots';
import { buildHubCategoryJsonLd } from '../utils/jsonld';
import type { Channel, Program } from '../types';

const normCid = (cid: string): string =>
  cid.toLowerCase().replace(/^de-/, '').replace(/\.de$/, '');

const today = getTodayInBerlin();
const dateLabel = formatDateDE(today);

const [channels, allPrograms] = await Promise.all([
  fetchChannels(),
  fetchProgramsForDate(today),
]);

// Build channel name lookup
const channelName = new Map<string, string>();
const channelLogo = new Map<string, string>();
for (const ch of channels) {
  const slug = normCid(ch.id);
  channelName.set(slug, ch.name);
  channelLogo.set(slug, ch.logo);
}

// Filter: Spielfilme heute Abend (ab 17:00)
const FILM_KEYWORDS = ['film', 'spielfilm', 'kinofilm', 'movie', 'kino', 'tv-movie', 'fernsehfilm', 'dokumentarfilm'];

function isFilm(prog: Program): boolean {
  const genre = (prog.category ?? '').toLowerCase();
  const hasYear = /\(\d{4}\)/.test(prog.title ?? '');
  return FILM_KEYWORDS.some(k => genre.includes(k)) || hasYear;
}

const films = allPrograms
  .filter(p => getBerlinHour(p.start_time) >= 17 && isFilm(p))
  .sort((a, b) => new Date(a.start_time).getTime() - new Date(b.start_time).getTime());

const jsonLd = buildHubCategoryJsonLd({
  categoryName: 'Filme',
  categorySlug: 'film-heute-abend',
  programs: films,
  today,
});

const description = 'Alle Spielfilme heute Abend im deutschen Fernsehen: Sendezeiten, Sender und Kurzbeschreibungen. Kein Film verpassen – der komplette Überblick.';
const keywords    = 'filme heute abend tv, kinofilme heute im tv, was läuft heute für filme im tv, spielfilme heute abend, film tv heute, fernsehfilm heute';
---

<BaseLayout
  title="Filme heute Abend im TV – Kinofilme & Sendezeiten | FernsehHeute"
  description={description}
  keywords={keywords}
  canonicalUrl="https://fernsehheute.de/film-heute-abend/"
  jsonLd={jsonLd}
>
  <Header />

  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-6">

    <div class="mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">🎬 Filme heute Abend im TV</h1>
      <p class="text-zinc-500 dark:text-zinc-400 mt-1">{dateLabel} · {films.length} Film{films.length !== 1 ? 'e' : ''} gefunden</p>
    </div>

    {films.length > 0 ? (
      <ul class="divide-y divide-slate-100 dark:divide-slate-800" role="list">
        {films.map(prog => {
          const slug = normCid(prog.channel_id ?? '');
          const name = channelName.get(slug) ?? prog.channel_id ?? '';
          const logo = channelLogo.get(slug) || '';

          const overlayJson = JSON.stringify({
            id:          prog.id,
            title:       prog.title,
            startTime:   prog.start_time,
            endTime:     prog.end_time,
            category:    prog.category ?? 'Spielfilm',
            description: prog.description ?? '',
            poster_url:  prog.poster_url ?? null,
            cast_json:   (prog as any).cast_json ?? null,
            channelId:   slug,
            channelLogo: logo,
            channelName: name,
          });

          return (
            <li class="flex gap-4 py-3.5 hover:bg-slate-50 dark:hover:bg-slate-800/50 rounded-xl px-2.5 transition-colors group">
              <!-- Poster / Fallback Badge -->
              <div
                class="shrink-0 w-16 h-24 sm:w-20 sm:h-28 rounded-xl overflow-hidden bg-gradient-to-br from-slate-800 to-slate-900 border border-slate-200 dark:border-slate-700/80 shadow-xs flex items-center justify-center cursor-pointer group-hover:scale-105 transition-transform"
                data-program={overlayJson}
                role="button"
                tabindex="0"
                title={`${prog.title} — Details ansehen`}
              >
                {prog.poster_url ? (
                  <img
                    src={prog.poster_url}
                    alt={prog.title}
                    width="80"
                    height="112"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                    class="w-full h-full object-cover"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                  />
                  <div class="hidden w-full h-full items-center justify-center bg-gradient-to-br from-purple-900 via-indigo-950 to-slate-950 text-2xl">
                    🎬
                  </div>
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-purple-900 via-indigo-950 to-slate-950 text-2xl">
                    🎬
                  </div>
                )}
              </div>

              <!-- Content -->
              <div class="flex-1 min-w-0 py-0.5">
                <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-0.5 mb-1">
                  <time datetime={prog.start_time} class="text-sm sm:text-base font-bold tabular-nums text-blue-600 dark:text-blue-400 shrink-0">
                    {formatTime(prog.start_time)}
                  </time>
                  <a href={`/${slug}/`} class="text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors shrink-0">
                    {name.replace(/^DE\s*-\s*/i, '')}
                  </a>
                  {prog.category && (
                    <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-purple-50 dark:bg-purple-950/50 text-purple-600 dark:text-purple-400 border border-purple-200/60 dark:border-purple-800/40">
                      {prog.category}
                    </span>
                  )}
                </div>

                <h2
                  class="font-bold text-base sm:text-lg text-slate-900 dark:text-slate-100 leading-snug cursor-pointer group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2"
                  data-program={overlayJson}
                  role="button"
                  tabindex="0"
                >
                  {prog.title}
                </h2>

                {prog.description && (
                  <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1 line-clamp-2 leading-relaxed">
                    {prog.description}
                  </p>
                )}
              </div>

              <!-- Channel logo -->
              {logo && (
                <div class="shrink-0 hidden sm:flex items-center justify-center w-14 h-10 self-center">
                  <img
                    src={logo}
                    alt={name}
                    width="56"
                    height="40"
                    loading="lazy"
                    class="max-w-[56px] max-h-[36px] w-auto h-auto object-contain opacity-80 group-hover:opacity-100 transition-opacity"
                    onerror="this.style.display='none'"
                  />
                </div>
              )}
            </li>
          );
        })}
      </ul>
    ) : (
      <div class="text-center py-16 text-zinc-500 dark:text-zinc-400">
        <p class="text-4xl mb-4" aria-hidden="true">🎬</p>
        <p class="text-lg font-medium">Keine Filme heute Abend gefunden</p>
      </div>
    )}
  </main>

  <Footer />
</BaseLayout>
