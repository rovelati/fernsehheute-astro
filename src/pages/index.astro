---
/**
 * Homepage — TV Programm heute Abend
 * Design: angelehnt an 123programmitv.it
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChannelCard from '../components/ChannelCard.astro';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInBerlin, formatDateDE, getBerlinHour } from '../utils/timeSlots';
import { buildHubHomeJsonLd, buildFaqJsonLd } from '../utils/jsonld';
import { normCid } from '../utils/channelSlug';
import { isAdultChannel, isTestChannel, filterRealPrograms } from '../utils/channelFilters';
import type { Channel, Program } from '../types';

const AGF_ORDER = [
  'rtl', 'zdf', 'das-erste', 'sat1', 'prosieben', 'vox', 'rtl2', 'kabel-eins',
  'sixx', 'super-rtl', 'nitro', 'tele5', 'zdf-neo', 'zdfinfo', '3sat', 'arte',
  'phoenix', 'one', 'sport1', 'eurosport1', 'eurosport-1', 'dmax', 'tlc', 'n-tv', 'ntv', 'welt',
  'tagesschau24', 'kika', 'comedy-central', 'disney-channel', 'ard-alpha',
  'sat1-gold', 'prosieben-maxx', 'kabel-eins-doku', 'mdr', 'ndr', 'wdr', 'br', 'swr', 'hr', 'rbb',
];

const today = getTodayInBerlin();
const dateLabel = formatDateDE(today);

type ChannelWithSlug = Channel & { slug: string; programs: Program[] };
let channelsWithPrograms: ChannelWithSlug[] = [];
let fetchError: string | null = null;

try {
  const [channels, allPrograms] = await Promise.all([
    fetchChannels(),
    fetchProgramsForDate(today),
  ]);

  const programsByChannel = new Map<string, Program[]>();
  for (const prog of allPrograms) {
    const key = normCid(prog.channel_id ?? '');
    if (!programsByChannel.has(key)) programsByChannel.set(key, []);
    programsByChannel.get(key)!.push(prog);
  }

  for (const ch of channels) {
    const slug = normCid(ch.id);
    if (isAdultChannel(slug, ch.name) || isTestChannel(slug, ch.name)) continue;

    const allChPrograms = programsByChannel.get(slug) ?? [];
    const realChPrograms = filterRealPrograms(allChPrograms);
    if (realChPrograms.length < 3) continue;

    const eveningPrograms = realChPrograms
      .filter(p => getBerlinHour(p.start_time) >= 17)
      .sort((a, b) => new Date(a.start_time).getTime() - new Date(b.start_time).getTime());

    if (eveningPrograms.length > 0) {
      channelsWithPrograms.push({ ...ch, programs: eveningPrograms, slug });
    }
  }

  channelsWithPrograms.sort((a, b) => {
    const ai = AGF_ORDER.indexOf(a.slug), bi = AGF_ORDER.indexOf(b.slug);
    if (ai === -1 && bi === -1) return 0;
    if (ai === -1) return 1;
    if (bi === -1) return -1;
    return ai - bi;
  });
} catch (err) {
  fetchError = err instanceof Error ? err.message : JSON.stringify(err);
  console.error('[index] fetch error:', fetchError);
}

import { serializeChannelForClient } from '../utils/channelSerializer';

const INITIAL_LIMIT = 50;
const initialChannels = channelsWithPrograms.slice(0, INITIAL_LIMIT);
const moreChannels    = channelsWithPrograms.slice(INITIAL_LIMIT);
const moreChannelsJson = JSON.stringify(moreChannels.map(ch => serializeChannelForClient(ch, 'abend')));

const FAQS = [
  {
    question: 'Was läuft heute um 20:15 Uhr im Fernsehen?',
    answer: 'Auf FernsehHeute findest du das komplette Hauptabendprogramm für heute ab 20:15 Uhr auf allen großen deutschen Sendern wie Das Erste (ARD), ZDF, RTL, SAT.1, ProSieben, VOX, Kabel Eins und vielen Sparten- und Regionalsendern.',
  },
  {
    question: 'Welche Sender sind im TV Programm heute enthalten?',
    answer: 'FernsehHeute bietet den vollständigen Sendeplan für über 40 frei empfangbare deutsche TV-Sender, darunter öffentlich-rechtliche Kanäle (ARD, ZDF, 3sat, Arte, WDR, NDR, BR, SWR, MDR, HR, RBB) sowie alle großen Privatsender.',
  },
  {
    question: 'Wo finde ich Filme und Serien für heute Abend?',
    answer: 'Über unsere Direktlinks im Menü erreichst du mit einem Klick alle Spielfilme (Filme heute Abend), Serien (Serien heute Abend) und Sportübertragungen sortiert nach Sendezeit.',
  },
  {
    question: 'Wie aktuell sind die Sendezeiten auf FernsehHeute?',
    answer: 'Unsere Programmdaten werden mehrmals täglich aktualisiert, sodass auch kurzfristige Programmänderungen und Sondersendungen schnell berücksichtigt werden.',
  },
];

const homeSchemas = buildHubHomeJsonLd({ channels: channelsWithPrograms, today });
const faqSchema   = buildFaqJsonLd(FAQS);
const jsonLd      = [...homeSchemas, faqSchema];

const pageTitle   = 'Fernsehprogramm heute & TV Programm ab 20:15 | FernsehHeute';
const description = 'Aktuelles Fernsehprogramm heute und TV Programm heute Abend: Was läuft heute im TV um 20:15 Uhr? Alle Sendungen, Spielfilme & Serien auf Das Erste, ZDF, RTL & allen Sendern im Überblick.';
const keywords    = 'fernsehprogramm heute, tv programm heute, fernsehprogramm heute abend, tv heute abend 20 uhr 15, fernsehen heute abend, tv programm heute abend, fernsehen heute, was läuft heute im tv, tv heute, programm heute';
---

<BaseLayout
  title={pageTitle}
  {description}
  {keywords}
  canonicalUrl="https://fernsehheute.de/"
  {jsonLd}
>
  <Header />

  <!-- ── Hero Section ─────────────────────────────────────────────────────── -->
  <section class="bg-gradient-to-b from-slate-50 to-white dark:from-slate-900 dark:to-slate-950 border-b border-slate-200/80 dark:border-slate-800 py-6 sm:py-9">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex items-center gap-2 mb-2.5">
        <span class="inline-flex items-center gap-1.5 text-[11px] font-black uppercase tracking-wider text-rose-600 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800/60 px-2.5 py-1 rounded-full shadow-xs">
          <span class="w-2 h-2 bg-rose-500 rounded-full animate-pulse inline-block"></span>
          Live & Prime Time 20:15
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-950 dark:text-white">
        Fernsehprogramm heute &amp; <span class="text-blue-600 dark:text-blue-400">TV Programm heute Abend</span>
      </h1>
      <p class="text-slate-600 dark:text-slate-400 mt-2.5 text-sm sm:text-base max-w-3xl leading-relaxed">
        <span class="font-semibold text-slate-800 dark:text-slate-200" data-live-date>{dateLabel}</span> &mdash; <strong>Was läuft heute im TV um 20:15 Uhr?</strong> 
        Das vollständige Fernsehprogramm von heute mit allen Hauptsendern und Spartenkanälen im Überblick: Spielfilme, Serien, Nachrichten und Live-Sport.
      </p>

      <!-- Search & Category Quick-Filter Bar -->
      <div class="mt-6 pt-4 border-t border-slate-200/60 dark:border-slate-800/60 flex flex-col md:flex-row gap-3 items-stretch md:items-center justify-between">
        <!-- Live Search Input -->
        <div class="relative flex-1 max-w-md">
          <input
            id="channel-search-input"
            type="search"
            placeholder="🔍 Sender oder Sendung suchen (z.B. ZDF, Tatort)..."
            class="w-full px-4 py-2.5 pl-10 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-xs placeholder:text-slate-400"
            aria-label="Sender oder Sendung suchen"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
        </div>

        <!-- Filter Chips -->
        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0 scrollbar-none text-xs font-semibold" id="category-filter-chips">
          <button type="button" data-filter="all" class="filter-chip px-3 py-1.5 rounded-lg bg-blue-600 text-white shadow-xs whitespace-nowrap transition-colors">
            Alle (<span id="visible-count">{channelsWithPrograms.length}</span>)
          </button>
          <button type="button" data-filter="main" class="filter-chip px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 whitespace-nowrap transition-colors">
            ⭐ Hauptsender
          </button>
          <button type="button" data-filter="film" class="filter-chip px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 whitespace-nowrap transition-colors">
            🎬 Spielfilme
          </button>
          <button type="button" data-filter="serie" class="filter-chip px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 whitespace-nowrap transition-colors">
            📺 Serien
          </button>
          <button type="button" data-filter="sport" class="filter-chip px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 whitespace-nowrap transition-colors">
            ⚽ Sport
          </button>
          <button type="button" data-filter="doku" class="filter-chip px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 whitespace-nowrap transition-colors">
            🌍 Doku & Wissen
          </button>
        </div>
      </div>
    </div>
  </section>

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8">

    <!-- Fehler -->
    {fetchError && (
      <div class="mb-6 p-4 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-400 text-sm">
        <strong>Datenabruf fehlgeschlagen:</strong> {fetchError}
      </div>
    )}

    <!-- Senderliste auf Zeilen (Full-Width Rows) -->
    {channelsWithPrograms.length > 0 ? (
      <section aria-label={`${channelsWithPrograms.length} Sender mit Abendsendungen`}>
        <div id="channels-grid" class="divide-y divide-slate-100 dark:divide-slate-800 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden bg-white dark:bg-slate-900/50 shadow-sm">
          {initialChannels.map(ch => (
            <ChannelCard
              channel={ch}
              programs={ch.programs}
              slug={ch.slug}
              mode="abend"
            />
          ))}

          {moreChannels.length > 0 && (
            <div id="more-channels-container" class="divide-y divide-slate-100 dark:divide-slate-800 hidden"></div>
          )}

          {moreChannels.length > 0 && (
            <div id="show-more-wrapper" class="text-center py-5 bg-slate-50/70 dark:bg-slate-900/40 border-t border-slate-100 dark:border-slate-800">
              <button
                id="show-more-btn"
                type="button"
                class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 font-bold text-sm border border-slate-200 dark:border-slate-700 shadow-xs transition-all active:scale-95 cursor-pointer"
              >
                <span>Alle {channelsWithPrograms.length} Sender anzeigen (+{moreChannels.length})</span>
                <svg class="w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6"/>
                </svg>
              </button>
            </div>
          )}
        </div>

        {moreChannels.length > 0 && (
          <script id="more-channels-data" type="application/json" set:html={moreChannelsJson} />
        )}

        <!-- No Results Fallback -->
        <div id="no-search-results" class="hidden text-center py-16 text-slate-500 dark:text-slate-400 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800">
          <p class="text-3xl mb-2">🔍</p>
          <p class="text-base font-bold text-slate-800 dark:text-slate-200">Keine passenden Sender gefunden</p>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Bitte versuche einen anderen Suchbegriff oder Filter.</p>
        </div>
      </section>
    ) : !fetchError ? (
      <div class="text-center py-16 text-slate-500 dark:text-slate-400 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800">
        <p class="text-4xl mb-4" aria-hidden="true">📺</p>
        <p class="text-lg font-medium">Keine Programmdaten verfügbar</p>
        <p class="text-sm mt-1">Bitte versuche es später erneut.</p>
      </div>
    ) : null}

    <!-- SEO FAQ Section -->
    <section class="mt-14 pt-10 border-t border-slate-200 dark:border-slate-800" aria-label="Häufige Fragen zum TV-Programm">
      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100 mb-6">
        Häufige Fragen zum TV Programm heute
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {FAQS.map(faq => (
          <div class="bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 sm:p-6 shadow-xs">
            <h3 class="font-bold text-slate-900 dark:text-slate-100 mb-2 text-base">
              {faq.question}
            </h3>
            <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<!-- Client-side Live Instant Filter Script -->
<script>
  (function () {
    const searchInput = document.getElementById('channel-search-input') as HTMLInputElement | null;
    const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
    const countEl = document.getElementById('visible-count');
    const noResultsEl = document.getElementById('no-search-results');
    const showMoreBtn = document.getElementById('show-more-btn');
    const moreContainer = document.getElementById('more-channels-container');
    const showMoreWrapper = document.getElementById('show-more-wrapper');

    const MAIN_SLUGS = new Set([
      'das-erste', 'zdf', 'rtl', 'sat1', 'prosieben', 'vox', 'kabel-eins', 'rtl2',
      'super-rtl', 'nitro', 'sixx', '3sat', 'arte', 'zdf-neo', 'tele5', 'sport1',
      'eurosport1', 'eurosport-1', 'dmax', 'welt', 'n-tv', 'ntv', 'phoenix', 'tagesschau24', 'kika', 'one'
    ]);

    let activeFilter = 'all';
    let searchQuery = '';

    function renderMoreChannels() {
      if (!moreContainer || moreContainer.dataset.rendered === 'true') return;
      const dataScript = document.getElementById('more-channels-data');
      if (!dataScript) return;
      try {
        const list = JSON.parse(dataScript.textContent || '[]');
        let html = '';
        for (const item of list) {
          const overlayData = JSON.stringify({
            id: item.progId,
            title: item.title,
            startTime: item.isoStart,
            endTime: item.isoEnd,
            category: item.cat,
            description: item.desc,
            poster_url: item.poster || null,
            channelId: item.slug,
            channelLogo: item.logo,
            channelName: item.name
          });
          html += `
<div
  class="channel-card-item block group border-b border-slate-100 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors"
  data-channel-card
  data-channel-name="${item.name.toLowerCase()}"
  data-channel-slug="${item.slug}"
  data-program-title="${(item.title || '').toLowerCase()}"
  data-category="${item.catGroup}"
  data-program='${overlayData.replace(/'/g, "&#39;")}'
>
  <div class="grid grid-cols-[68px_1fr_auto] sm:grid-cols-[84px_1fr_auto] gap-2.5 sm:gap-4 px-3 py-2.5 sm:px-4 sm:py-3 items-center">
    <a href="/${item.slug}/" class="flex flex-col items-start gap-1 focus:outline-none" aria-label="Programmübersicht ${item.name}">
      <div class="w-8 h-8 sm:w-9 sm:h-9 flex-shrink-0 flex items-center justify-center overflow-hidden rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-xs p-1 group-hover:scale-105 transition-transform">
        <img src="${item.logo}" alt="Logo ${item.name}" width="36" height="36" class="w-full h-full object-contain" loading="lazy" onerror="this.style.opacity='0.4';" />
      </div>
      <div class="min-w-0 w-full">
        <p class="text-[11px] sm:text-xs font-bold text-slate-900 dark:text-slate-100 leading-tight truncate group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
          ${item.displayName}
        </p>
        ${item.number > 0 ? `<p class="text-[10px] text-slate-400 dark:text-slate-500">CH ${item.number}</p>` : ''}
      </div>
    </a>
    <div class="min-w-0 py-0.5 cursor-pointer" role="button" tabindex="0" title="Klicken für Details">
      ${item.title ? `
        <div>
          <p class="text-[10px] sm:text-[11px] text-slate-400 dark:text-slate-500 mb-0.5 flex items-center gap-1.5 flex-wrap">
            <span class="tabular-nums font-semibold text-slate-700 dark:text-slate-300">${item.start} – ${item.end}</span>
            ${item.cat ? `<span class="uppercase tracking-wide font-semibold text-slate-400 dark:text-slate-500">${item.cat}</span>` : ''}
          </p>
          <p class="text-[13px] sm:text-sm font-bold text-slate-900 dark:text-slate-100 leading-snug mb-1.5 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
            ${item.title}
          </p>
          <div class="h-[3px] w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700 mb-1.5">
            <div class="h-full rounded-full bg-slate-300 dark:bg-slate-600" style="width:0%"></div>
          </div>
          ${item.nextTitle ? `
            <p class="text-[11px] sm:text-xs text-slate-400 dark:text-slate-500 truncate">
              <span class="tabular-nums">${item.nextStart}</span> — <span class="text-slate-600 dark:text-slate-400">${item.nextTitle}</span>
            </p>
          ` : ''}
        </div>
      ` : `
        <p class="text-xs text-slate-400 dark:text-slate-500 italic">Kein Programm verfügbar</p>
      `}
    </div>
    <div class="flex items-center gap-2 shrink-0">
      ${item.poster ? `
        <div class="w-16 sm:w-24 aspect-video shrink-0 rounded-lg overflow-hidden bg-slate-900 border border-slate-200 dark:border-slate-700/80 shadow-xs cursor-pointer group-hover:scale-105 transition-transform" role="button" tabindex="0" title="${item.title} — Details ansehen">
          <img src="${item.poster}" alt="${item.title}" width="96" height="54" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="w-full h-full object-cover object-top" onerror="this.parentElement.style.display='none'" />
        </div>
      ` : ''}
      <div class="hidden sm:flex items-center justify-center pl-1">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="text-slate-300 dark:text-slate-600 group-hover:text-blue-400 transition-colors">
          <path d="M5 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
    </div>
  </div>
</div>`;
        }
        moreContainer.innerHTML = html;
        moreContainer.dataset.rendered = 'true';
      } catch (e) {
        console.error('Error parsing more channels', e);
      }
    }

    function revealAllChannels() {
      renderMoreChannels();
      if (moreContainer) moreContainer.classList.remove('hidden');
      if (showMoreWrapper) showMoreWrapper.style.display = 'none';
    }

    if (showMoreBtn) {
      showMoreBtn.addEventListener('click', () => {
        revealAllChannels();
      });
    }

    function applyFilters() {
      if (searchQuery || activeFilter !== 'all') {
        revealAllChannels();
      }

      const allCards = document.querySelectorAll<HTMLElement>('[data-channel-card]');
      let visible = 0;
      allCards.forEach(card => {
        const name = card.getAttribute('data-channel-name') || '';
        const slug = card.getAttribute('data-channel-slug') || '';
        const title = card.getAttribute('data-program-title') || '';
        const cat = card.getAttribute('data-category') || '';

        // Search match
        const matchesSearch = !searchQuery ||
          name.includes(searchQuery) ||
          slug.includes(searchQuery) ||
          title.includes(searchQuery);

        // Category chip match
        let matchesCategory = true;
        if (activeFilter === 'main') {
          matchesCategory = MAIN_SLUGS.has(slug);
        } else if (activeFilter !== 'all') {
          matchesCategory = cat === activeFilter;
        }

        const isVisible = matchesSearch && matchesCategory;
        card.style.display = isVisible ? '' : 'none';
        if (isVisible) visible++;
      });

      if (countEl) countEl.textContent = String(visible);
      if (noResultsEl) noResultsEl.classList.toggle('hidden', visible > 0);
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        applyFilters();
      });
    }

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        chips.forEach(c => {
          c.classList.remove('bg-blue-600', 'text-white');
          c.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
        });
        chip.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
        chip.classList.add('bg-blue-600', 'text-white');

        activeFilter = chip.getAttribute('data-filter') || 'all';
        applyFilters();
      });
    });
  })();
</script>




