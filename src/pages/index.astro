---
/**
 * Homepage — TV Programm heute Abend
 * Design: angelehnt an 123programmitv.it
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChannelCard from '../components/ChannelCard.astro';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInBerlin, formatDateDE, getBerlinHour } from '../utils/timeSlots';
import { buildHubHomeJsonLd } from '../utils/jsonld';
import type { Channel, Program } from '../types';

const normCid = (cid: string): string =>
  cid.toLowerCase().replace(/^de-/, '').replace(/\.de$/, '');

const AGF_ORDER = [
  'rtl', 'zdf', 'das-erste', 'sat1', 'prosieben', 'vox', 'rtl2', 'kabel-eins',
  'sixx', 'super-rtl', 'nitro', 'tele5', 'zdf-neo', 'zdfinfo', '3sat', 'arte',
  'phoenix', 'one', 'sport1', 'eurosport-1', 'dmax', 'tlc', 'n-tv', 'ntv', 'welt',
  'tagesschau24', 'kika', 'comedy-central', 'disney-channel', 'ard-alpha',
  'sat1-gold', 'prosieben-maxx', 'kabel-eins-doku', 'mdr', 'ndr', 'wdr', 'br', 'swr', 'hr', 'rbb',
];

const today = getTodayInBerlin();
const dateLabel = formatDateDE(today);

type ChannelWithSlug = Channel & { slug: string; programs: Program[] };
let channelsWithPrograms: ChannelWithSlug[] = [];
let fetchError: string | null = null;

try {
  const [channels, allPrograms] = await Promise.all([
    fetchChannels(),
    fetchProgramsForDate(today),
  ]);

  const programsByChannel = new Map<string, Program[]>();
  for (const prog of allPrograms) {
    const key = normCid(prog.channel_id ?? '');
    if (!programsByChannel.has(key)) programsByChannel.set(key, []);
    programsByChannel.get(key)!.push(prog);
  }

  for (const ch of channels) {
    const slug = normCid(ch.id);
    const programs = (programsByChannel.get(slug) ?? [])
      .filter(p => getBerlinHour(p.start_time) >= 17)
      .sort((a, b) => new Date(a.start_time).getTime() - new Date(b.start_time).getTime());
    if (programs.length > 0) channelsWithPrograms.push({ ...ch, programs, slug });
  }

  channelsWithPrograms.sort((a, b) => {
    const ai = AGF_ORDER.indexOf(a.slug), bi = AGF_ORDER.indexOf(b.slug);
    if (ai === -1 && bi === -1) return 0;
    if (ai === -1) return 1;
    if (bi === -1) return -1;
    return ai - bi;
  });
} catch (err) {
  fetchError = err instanceof Error ? err.message : JSON.stringify(err);
  console.error('[index] fetch error:', fetchError);
}

const jsonLd = buildHubHomeJsonLd({ channels: channelsWithPrograms, today });
const description = 'TV Programm heute Abend: alle Sendungen auf ARD, ZDF, RTL, SAT.1, ProSieben und weiteren deutschen Sendern mit genauen Sendezeiten auf einen Blick.';
const keywords    = 'tv programm heute abend, fernsehprogramm heute, was läuft heute im tv, tv heute abend, fernsehen heute, deutsches fernsehprogramm';
---

<BaseLayout
  title="TV Programm heute Abend – Alle Sender & Sendezeiten | FernsehHeute"
  {description}
  {keywords}
  canonicalUrl="https://fernsehheute.de/"
  {jsonLd}
>
  <Header />

  <!-- ── Hero Section ─────────────────────────────────────────────────────── -->
  <section class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 py-5 sm:py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex items-center gap-2 mb-2">
        <span class="inline-flex items-center gap-1.5 text-[11px] font-black uppercase tracking-wider text-rose-600 bg-rose-50 dark:bg-rose-900/20 border border-rose-200 dark:border-rose-800/50 px-2.5 py-1 rounded-full">
          <span class="w-1.5 h-1.5 bg-rose-500 rounded-full animate-pulse inline-block"></span>
          Aktuell
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-slate-100">
        TV Programm <span class="text-blue-600 dark:text-blue-400">heute Abend</span>
      </h1>
      <p class="text-slate-500 dark:text-slate-400 mt-2 text-sm sm:text-base">
        {dateLabel} &mdash; {channelsWithPrograms.length} Sender, alle Sendungen ab 17:00 Uhr
      </p>
      <div class="flex flex-wrap gap-2 mt-4">
        {[
          { href: '/morgen',             label: 'Morgen'        },
          { href: '/film-heute-abend',   label: '🎬 Filme'      },
          { href: '/serien-heute-abend', label: '📺 Serien'     },
          { href: '/sport-heute-abend',  label: '⚽ Sport'      },
        ].map(item => (
          <a href={item.href} class="text-sm font-semibold px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:border-blue-400 hover:text-blue-600 dark:hover:border-blue-500 dark:hover:text-blue-400 transition-colors">
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 py-6">

    <!-- Fehler -->
    {fetchError && (
      <div class="mb-6 p-4 rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-400 text-sm">
        <strong>Datenabruf fehlgeschlagen:</strong> {fetchError}
      </div>
    )}

    <!-- Senderliste -->
    {channelsWithPrograms.length > 0 ? (
      <section aria-label={`${channelsWithPrograms.length} Sender mit Abendsendungen`}>
        <div class="divide-y divide-slate-100 dark:divide-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden bg-white dark:bg-slate-900/50">
          {channelsWithPrograms.map(ch => (
            <ChannelCard
              channel={ch}
              programs={ch.programs}
              slug={ch.slug}
              mode="abend"
            />
          ))}
        </div>
      </section>
    ) : !fetchError ? (
      <div class="text-center py-16 text-slate-500 dark:text-slate-400">
        <p class="text-4xl mb-4" aria-hidden="true">📺</p>
        <p class="text-lg font-medium">Keine Programmdaten verfügbar</p>
        <p class="text-sm mt-1">Bitte versuche es später erneut.</p>
      </div>
    ) : null}

  </main>

  <Footer />
</BaseLayout>
