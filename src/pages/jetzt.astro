---
/**
 * /jetzt/ — Was läuft jetzt im TV?
 * Intercetta: "was läuft jetzt im tv", "tv programm jetzt", "fernsehprogramm jetzt" (1.350.000 ric./mese)
 * Con Live-Fortschrittsbalken client-side calcolato in tempo reale da EPG compatto.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChannelCard from '../components/ChannelCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { ADSENSE_SLOTS } from '../lib/adsense';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInBerlin, formatDateDE, formatTime } from '../utils/timeSlots';
import { buildHubJetztJsonLd, buildFaqJsonLd } from '../utils/jsonld';
import { normCid } from '../utils/channelSlug';
import { isAdultChannel, isTestChannel, filterRealPrograms } from '../utils/channelFilters';
import { AGF_ORDER } from '../utils/agfOrder';
import type { Channel, Program } from '../types';

const today = getTodayInBerlin();
const dateLabel = formatDateDE(today);

type ChannelWithSlug = Channel & { slug: string; programs: Program[] };
let channelsWithPrograms: ChannelWithSlug[] = [];
let fetchError: string | null = null;

try {
  const [channels, allPrograms] = await Promise.all([
    fetchChannels(),
    fetchProgramsForDate(today),
  ]);

  const programsByChannel = new Map<string, Program[]>();
  for (const prog of allPrograms) {
    const key = normCid(prog.channel_id ?? '');
    if (!programsByChannel.has(key)) programsByChannel.set(key, []);
    programsByChannel.get(key)!.push(prog);
  }

  for (const ch of channels) {
    const slug = normCid(ch.id);
    if (isAdultChannel(slug, ch.name) || isTestChannel(slug, ch.name)) continue;

    const allChPrograms = programsByChannel.get(slug) ?? [];
    const realChPrograms = filterRealPrograms(allChPrograms);
    if (realChPrograms.length < 3) continue;

    const sortedPrograms = realChPrograms
      .sort((a, b) => new Date(a.start_time).getTime() - new Date(b.start_time).getTime());

    channelsWithPrograms.push({ ...ch, programs: sortedPrograms, slug });
  }

  channelsWithPrograms.sort((a, b) => {
    const ai = AGF_ORDER.indexOf(a.slug), bi = AGF_ORDER.indexOf(b.slug);
    if (ai === -1 && bi === -1) return 0;
    if (ai === -1) return 1;
    if (bi === -1) return -1;
    return ai - bi;
  });
} catch (err) {
  fetchError = err instanceof Error ? err.message : JSON.stringify(err);
  console.error('[jetzt] fetch error:', fetchError);
}

// Compact JSON for real-time client-side live tracking
// [id, title, startSec, endSec, category, poster_url, description]
const liveEpgData: Record<string, [string, string, number, number, string, string | null, string][]> = {};
for (const ch of channelsWithPrograms) {
  liveEpgData[ch.slug] = ch.programs.map(p => [
    p.id,
    p.title,
    Math.floor(new Date(p.start_time).getTime() / 1000),
    Math.floor(new Date(p.end_time).getTime() / 1000),
    p.category ?? '',
    p.poster_url ?? null,
    p.description ? p.description.slice(0, 240) : '',
  ]);
}
const liveEpgJson = JSON.stringify(liveEpgData);

const FAQS = [
  {
    question: 'Was läuft jetzt live im Fernsehen?',
    answer: 'Auf dieser Seite siehst du in Echtzeit, welche Sendungen aktuell auf allen großen deutschen TV-Sendern wie Das Erste (ARD), ZDF, RTL, ProSieben, SAT.1, VOX, Kabel Eins sowie allen dritten Programmen und Spartenkanälen laufen – inklusive verbleibender Sendezeit.',
  },
  {
    question: 'Wie genau sind die Sendezeiten für das laufende Programm?',
    answer: 'Unsere Programmdaten werden kontinuierlich synchronisiert. Ein dynamischer Live-Fortschrittsbalken berechnet für jede Sendung sekundengenau, wie viel Zeit bereits vergangen ist und wann die nachfolgende Sendung beginnt.',
  },
  {
    question: 'Kann ich die laufenden Sendungen direkt online sehen?',
    answer: 'Ja, über einen Klick auf das Senderlogo gelangst du direkt zur Senderübersicht mit offiziellen Livestream- und Mediathek-Verlinkungen für ARD, ZDF, RTL+ und Joyn.',
  },
  {
    question: 'Was läuft heute Abend um 20:15 Uhr?',
    answer: 'Für das Hauptabendprogramm kannst du mit einem Klick auf unsere Prime-Time-Übersicht (20:15 Uhr) wechseln, um alle Spielfilme, Serien und Shows von heute Abend zu sehen.',
  },
];

const jetztSchemas = buildHubJetztJsonLd({ channels: channelsWithPrograms });
const faqSchema    = buildFaqJsonLd(FAQS);
const jsonLd       = [...jetztSchemas, faqSchema];

const pageTitle   = 'Was läuft jetzt im TV? – TV-Programm & Sendungen aktuell | FernsehHeute';
const description = 'Was läuft jetzt im TV? Das aktuelle Fernsehprogramm auf allen Sendern: Live im TV mit Sendezeiten, Live-Fortschrittsbalken und nachfolgenden Sendungen im Überblick.';
const keywords    = 'was läuft jetzt im tv, tv programm jetzt, fernsehprogramm jetzt, jetzt im tv, fernsehen jetzt, was läuft gerade im tv, live tv programm, tv heute jetzt';
---

<BaseLayout
  title={pageTitle}
  {description}
  {keywords}
  canonicalUrl="https://fernsehheute.de/jetzt/"
  {jsonLd}
>
  <Header />

  <!-- ── Hero Section ─────────────────────────────────────────────────────── -->
  <section class="bg-gradient-to-b from-slate-50 to-white dark:from-slate-900 dark:to-slate-950 border-b border-slate-200/80 dark:border-slate-800 py-6 sm:py-9">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex items-center gap-2 mb-2.5">
        <span class="inline-flex items-center gap-1.5 text-[11px] font-black uppercase tracking-wider text-rose-600 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800/60 px-2.5 py-1 rounded-full shadow-xs">
          <span class="w-2 h-2 bg-rose-500 rounded-full animate-pulse inline-block"></span>
          Live im TV
        </span>
        <span id="hero-live-clock" class="text-xs font-semibold text-slate-500 dark:text-slate-400">
          Uhrzeit: <span id="clock-display" class="tabular-nums font-bold text-slate-800 dark:text-slate-200">--:--</span> Uhr
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-950 dark:text-white">
        Was läuft jetzt im TV? &mdash; <span class="text-blue-600 dark:text-blue-400">Aktuelles Fernsehprogramm</span>
      </h1>
      <p class="text-slate-600 dark:text-slate-400 mt-2.5 text-sm sm:text-base max-w-3xl leading-relaxed">
        <span class="font-semibold text-slate-800 dark:text-slate-200">{dateLabel}</span> &mdash; 
        <strong>Aktuelle Sendungen in Echtzeit:</strong> Was läuft gerade im Fernsehen auf ARD, ZDF, RTL, ProSieben, SAT.1 und allen Sendern? Mit Live-Fortschritt und nächstem Programm.
      </p>

      <!-- Quick Switcher Navigation Pills -->
      <div class="mt-5 flex flex-wrap items-center gap-2">
        <span class="px-3 py-1.5 rounded-xl text-xs font-bold bg-blue-600 text-white shadow-xs flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 bg-white rounded-full animate-pulse"></span>
          ⚡ Jetzt live im TV
        </span>
        <a href="/20-15/" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-amber-400 hover:text-amber-600 transition-colors">
          🌙 20:15 Prime Time
        </a>
        <a href="/" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-blue-400 hover:text-blue-600 transition-colors">
          📺 Heute Abend
        </a>
        <a href="/film-heute-abend/" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-blue-400 hover:text-blue-600 transition-colors">
          🎬 Spielfilme
        </a>
        <a href="/morgen/" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-blue-400 hover:text-blue-600 transition-colors">
          📅 Morgen
        </a>
      </div>

      <!-- Search Filter Bar -->
      <div class="mt-6 pt-4 border-t border-slate-200/60 dark:border-slate-800/60 flex flex-col md:flex-row gap-3 items-stretch md:items-center justify-between">
        <div class="relative flex-1 max-w-md">
          <input
            id="channel-search-input"
            type="search"
            placeholder="🔍 Sender oder laufende Sendung suchen..."
            class="w-full px-4 py-2.5 pl-10 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-xs placeholder:text-slate-400"
            aria-label="Sender oder Sendung suchen"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
          </svg>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          <strong class="text-slate-800 dark:text-slate-200">{channelsWithPrograms.length} Sender</strong> mit aktuellem Live-Status
        </p>
      </div>
    </div>
  </section>

  <!-- ── Main Grid ─────────────────────────────────────────────────────────── -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden divide-y divide-slate-100 dark:divide-slate-800">
      {channelsWithPrograms.slice(0, 10).map(ch => (
        <ChannelCard channel={ch} programs={ch.programs} slug={ch.slug} mode="jetzt" />
      ))}
    </div>

    <!-- AdSlot In-Feed -->
    <AdSlot slot={ADSENSE_SLOTS.IN_FEED_SENDERLISTE} inFeedWrapper={true} minHeight={160} />

    {channelsWithPrograms.length > 10 && (
      <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden divide-y divide-slate-100 dark:divide-slate-800 mt-6">
        {channelsWithPrograms.slice(10).map(ch => (
          <ChannelCard channel={ch} programs={ch.programs} slug={ch.slug} mode="jetzt" />
        ))}
      </div>
    )}

    <!-- FAQ Section -->
    <section class="mt-12 bg-slate-50 dark:bg-slate-900/60 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-6 sm:p-8">
      <h2 class="text-xl sm:text-2xl font-bold text-slate-950 dark:text-white mb-6 flex items-center gap-2">
        <span>❓</span> Häufige Fragen zum aktuellen Fernsehprogramm (FAQ)
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {FAQS.map(faq => (
          <div class="bg-white dark:bg-slate-800/80 rounded-xl p-5 border border-slate-200/60 dark:border-slate-700/60">
            <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-slate-100 mb-2">
              {faq.question}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- AdSlot Pre-Footer -->
    <AdSlot slot={ADSENSE_SLOTS.CONTENT_FOOTER_FAQ} minHeight={200} />
  </main>

  <Footer />

  <!-- Compact Live EPG Payload for JS tracking -->
  <script id="live-epg-data" type="application/json" set:html={liveEpgJson} />

  <!-- Client-side Real-time Live Engine -->
  <script is:inline>
    (function () {
      function fmtTime(sec) {
        var d = new Date(sec * 1000);
        return d.toLocaleTimeString('de-DE', {
          timeZone: 'Europe/Berlin',
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
        });
      }

      function esc(str) {
        return String(str || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      var epgEl = document.getElementById('live-epg-data');
      if (!epgEl) return;
      var liveEpg = {};
      try {
        liveEpg = JSON.parse(epgEl.textContent || '{}');
      } catch (e) {
        return;
      }

      function updateClock() {
        var clockEl = document.getElementById('clock-display');
        if (clockEl) {
          var now = new Date();
          clockEl.textContent = now.toLocaleTimeString('de-DE', {
            timeZone: 'Europe/Berlin',
            hour: '2-digit',
            minute: '2-digit',
            hour12: false,
          });
        }
      }

      function updateLiveCards() {
        var nowSec = Math.floor(Date.now() / 1000);
        var cards = document.querySelectorAll('.jetzt-card');

        cards.forEach(function (card) {
          var slug = card.getAttribute('data-channel-slug');
          var logo = card.getAttribute('data-channel-logo') || '';
          var chName = card.getAttribute('data-channel-name') || slug;
          var progs = liveEpg[slug];
          if (!progs || !progs.length) return;

          // Find current live program
          var currentProg = null;
          var nextProg = null;
          for (var i = 0; i < progs.length; i++) {
            var p = progs[i];
            if (p[2] <= nowSec && nowSec < p[3]) {
              currentProg = p;
              nextProg = progs[i + 1] || null;
              break;
            }
          }

          // Fallback to closest future or last past
          if (!currentProg) {
            for (var j = 0; j < progs.length; j++) {
              if (progs[j][2] > nowSec) {
                currentProg = progs[j];
                nextProg = progs[j + 1] || null;
                break;
              }
            }
            if (!currentProg) currentProg = progs[progs.length - 1];
          }

          var contentEl = card.querySelector('.jetzt-program-content');
          if (!contentEl || !currentProg) return;

          var isLive = currentProg[2] <= nowSec && nowSec < currentProg[3];
          var durSec = Math.max(1, currentProg[3] - currentProg[2]);
          var elapsedSec = Math.max(0, nowSec - currentProg[2]);
          var pct = isLive ? Math.min(100, Math.max(0, Math.round((elapsedSec / durSec) * 100))) : 0;
          var remainMin = isLive ? Math.max(1, Math.round((currentProg[3] - nowSec) / 60)) : 0;

          var overlayData = {
            id: currentProg[0],
            title: currentProg[1],
            startTime: new Date(currentProg[2] * 1000).toISOString(),
            endTime: new Date(currentProg[3] * 1000).toISOString(),
            category: currentProg[4] || '',
            poster_url: currentProg[5] || null,
            description: currentProg[6] || '',
            channelId: slug,
            channelLogo: logo,
            channelName: chName,
          };

          contentEl.setAttribute('data-program', JSON.stringify(overlayData));

          var badgeHTML = isLive
            ? '<span class="inline-flex items-center gap-1 text-[9px] font-black uppercase tracking-wider text-rose-600 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800/60 px-1.5 py-0.5 rounded-full"><span class="w-1.5 h-1.5 bg-rose-500 rounded-full animate-pulse inline-block"></span>Live</span>'
            : '<span class="inline-flex items-center text-[9px] font-semibold uppercase tracking-wider text-slate-500 bg-slate-100 dark:bg-slate-800 px-1.5 py-0.5 rounded-full">Demnächst</span>';

          var remainHTML = isLive
            ? '<span class="text-blue-600 dark:text-blue-400 font-semibold text-[10px]">noch ' + remainMin + ' Min.</span>'
            : '';

          var catHTML = currentProg[4]
            ? '<span class="uppercase tracking-wide font-semibold text-slate-400 dark:text-slate-500">' + esc(currentProg[4]) + '</span>'
            : '';

          var nextHTML = nextProg
            ? '<p class="text-[11px] sm:text-xs text-slate-400 dark:text-slate-500 truncate"><span class="tabular-nums font-semibold">' + fmtTime(nextProg[2]) + '</span> — <span class="text-slate-600 dark:text-slate-400">' + esc(nextProg[1]) + '</span></p>'
            : '';

          contentEl.innerHTML =
            '<div>' +
              '<p class="text-[10px] sm:text-[11px] text-slate-400 dark:text-slate-500 mb-0.5 flex items-center gap-1.5 flex-wrap">' +
                badgeHTML +
                '<span class="tabular-nums font-semibold text-slate-700 dark:text-slate-300">' + fmtTime(currentProg[2]) + ' – ' + fmtTime(currentProg[3]) + '</span>' +
                remainHTML +
                catHTML +
              '</p>' +
              '<p class="text-[13px] sm:text-sm font-bold text-slate-900 dark:text-slate-100 leading-snug mb-1.5 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">' +
                esc(currentProg[1]) +
              '</p>' +
              '<div class="h-[3px] w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700 mb-1.5">' +
                '<div class="h-full rounded-full bg-blue-500 dark:bg-blue-400 transition-all" style="width:' + pct + '%"></div>' +
              '</div>' +
              nextHTML +
            '</div>';
        });
      }

      // Initial execution + interval
      updateClock();
      updateLiveCards();
      setInterval(function () {
        updateClock();
        updateLiveCards();
      }, 30000);

      // Search filter integration
      var searchInput = document.getElementById('channel-search-input');
      if (searchInput) {
        searchInput.addEventListener('input', function (e) {
          var q = (e.target.value || '').toLowerCase().trim();
          document.querySelectorAll('.channel-card-item').forEach(function (el) {
            var name = el.getAttribute('data-channel-name') || '';
            var title = el.getAttribute('data-program-title') || '';
            var match = !q || name.indexOf(q) !== -1 || title.indexOf(q) !== -1;
            el.style.display = match ? '' : 'none';
          });
        });
      }
    })();
  </script>
</BaseLayout>
