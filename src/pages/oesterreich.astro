---
/**
 * /oesterreich/ — TV-Programm Österreich heute Abend
 *
 * Speziell optimiert für Zuschauer und Suchanfragen aus Österreich (google.at):
 * - ORF 1, ORF 2, ORF III, ORF Sport+
 * - ServusTV, ATV, ATV2, PULS 4, PULS 24, oe24.TV, krone.tv
 * - W24, R9, Tirol TV, Ländle TV, KT 1
 * - Plus die in Österreich über Magenta, A1 und Drei beliebtesten Partnersender (3sat, Das Erste, ZDF, RTL, ProSieben, SAT.1)
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChannelCard from '../components/ChannelCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { ADSENSE_SLOTS } from '../lib/adsense';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInBerlin, formatDateDE, getBerlinHour } from '../utils/timeSlots';
import { buildFaqJsonLd } from '../utils/jsonld';
import { normCid } from '../utils/channelSlug';
import { isAdultChannel, isTestChannel, filterRealPrograms } from '../utils/channelFilters';
import { AUSTRIA_ORDER } from '../utils/austriaOrder';
import type { Channel, Program } from '../types';

const today = getTodayInBerlin();
const dateLabel = formatDateDE(today);

type ChannelWithSlug = Channel & { slug: string; programs: Program[] };
let channelsWithPrograms: ChannelWithSlug[] = [];
let fetchError: string | null = null;

try {
  const [channels, allPrograms] = await Promise.all([
    fetchChannels(),
    fetchProgramsForDate(today),
  ]);

  const programsByChannel = new Map<string, Program[]>();
  for (const prog of allPrograms) {
    const key = normCid(prog.channel_id ?? '');
    if (!programsByChannel.has(key)) programsByChannel.set(key, []);
    programsByChannel.get(key)!.push(prog);
  }

  for (const ch of channels) {
    const slug = normCid(ch.id);
    if (isAdultChannel(slug, ch.name) || isTestChannel(slug, ch.name)) continue;

    // Auf der Österreich-Seite: nur Sender der AUSTRIA_ORDER berücksichtigen
    if (!AUSTRIA_ORDER.includes(slug) && ch.category !== 'oesterreich') continue;

    const allChPrograms = programsByChannel.get(slug) ?? [];
    const realChPrograms = filterRealPrograms(allChPrograms);
    if (realChPrograms.length < 2) continue;

    const eveningPrograms = realChPrograms
      .filter(p => getBerlinHour(p.start_time) >= 17)
      .sort((a, b) => new Date(a.start_time).getTime() - new Date(b.start_time).getTime());

    if (eveningPrograms.length > 0) {
      channelsWithPrograms.push({ ...ch, programs: eveningPrograms, slug });
    }
  }

  // Streng nach österreichischen Marktanteilen und Relevanz sortieren
  channelsWithPrograms.sort((a, b) => {
    const ai = AUSTRIA_ORDER.indexOf(a.slug);
    const bi = AUSTRIA_ORDER.indexOf(b.slug);
    if (ai === -1 && bi === -1) return 0;
    if (ai === -1) return 1;
    if (bi === -1) return -1;
    return ai - bi;
  });
} catch (err) {
  fetchError = err instanceof Error ? err.message : JSON.stringify(err);
  console.error('[oesterreich] fetch error:', fetchError);
}

const FAQS = [
  {
    question: 'Was spielt es heute im Fernsehen?',
    answer: 'Auf FernsehHeute finden Sie das tagesaktuelle Fernsehprogramm für den Hauptabend auf allen beliebten Sendern: ORF 1, ORF 2, ORF III, ServusTV, ATV, PULS 4, PULS 24 sowie den Partnersendern 3sat, Das Erste, ZDF, RTL und ProSieben.',
  },
  {
    question: 'Wann beginnt der Hauptabend?',
    answer: 'Im Fernsehen beginnt der Hauptabend (die Prime Time) traditionell um 20:15 Uhr. Auf ORF 1 und ORF 2 startet das Abendprogramm direkt nach der ZIB 1 (19:30 Uhr), Sport aktuell (19:55 Uhr) und dem Wetter (20:05 Uhr). Private Sender wie ServusTV, ATV und PULS 4 beginnen ihre Spielfilme und Shows ebenfalls um 20:15 Uhr.',
  },
  {
    question: 'Welche Sender sind im TV-Programm vertreten?',
    answer: 'Das Programm umfasst die öffentlich-rechtlichen Kanäle des ORF (ORF 1, ORF 2, ORF III, ORF Sport+), die großen Privatsender (ServusTV von Red Bull Media House, ATV, ATV2, PULS 4 und den 24-Stunden-Nachrichtensender PULS 24 der ProSiebenSat.1 PULS 4 Gruppe, oe24.TV, krone.tv) sowie regionale Stationen wie W24, R9, Tirol TV und Ländle TV.',
  },
  {
    question: 'Wo kann ich die Sender live im Internet streamen?',
    answer: 'Sendungen des ORF können über die Plattform ORF ON (ehemals TVthek) kostenlos im Live-Stream und on demand abgerufen werden. Die Sender ATV, PULS 4 und PULS 24 streamen live und gratis auf Joyn. ServusTV ist kostenlos über die Plattform ServusTV On verfügbar.',
  },
];

const pageTitle   = "TV-Programm heute: ORF 1, ORF 2, ServusTV & ATV | FernsehHeute";
const description = "Was spielt's heute im Fernsehen? Alle Sendungen auf ORF 1, ORF 2, ServusTV, ATV & PULS 4 heute Abend und im Hauptabend auf einen Blick.";
const keywords    = "tv programm heute, fernsehprogramm heute, was spielt es heute im fernsehen, orf 1 programm heute abend, orf 2 programm, servustv programm, atv programm, puls 4 programm, hauptabendprogramm heute, was spielt's heute im tv";

// JSON-LD Structured Data
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://fernsehheute.de/oesterreich/#webpage',
    'url': 'https://fernsehheute.de/oesterreich/',
    'name': pageTitle,
    'description': description,
    'inLanguage': 'de-AT',
    'isPartOf': {
      '@type': 'WebSite',
      '@id': 'https://fernsehheute.de/#website',
      'name': 'FernsehHeute',
      'url': 'https://fernsehheute.de/',
    },
    'breadcrumb': {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Startseite',
          'item': 'https://fernsehheute.de/',
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': 'Österreich TV-Programm',
          'item': 'https://fernsehheute.de/oesterreich/',
        },
      ],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    'name': 'Österreichische TV-Sender heute im Programm',
    'numberOfItems': channelsWithPrograms.length,
    'itemListElement': channelsWithPrograms.slice(0, 30).map((ch, idx) => ({
      '@type': 'ListItem',
      'position': idx + 1,
      'name': ch.name,
      'url': `https://fernsehheute.de/${ch.slug}/`,
    })),
  },
  buildFaqJsonLd(FAQS),
];
---

<BaseLayout
  title={pageTitle}
  {description}
  {keywords}
  canonicalUrl="https://fernsehheute.de/oesterreich/"
  {jsonLd}
>
  <Header />

  <!-- ── Hero Section ─────────────────────────────────────────────────────── -->
  <section class="bg-gradient-to-b from-red-50/40 via-slate-50 to-white dark:from-slate-900 dark:via-slate-900/90 dark:to-slate-950 border-b border-slate-200/80 dark:border-slate-800 py-6 sm:py-9">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      
      <!-- Region Badge -->
      <div class="flex items-center gap-2 mb-2.5">
        <span class="inline-flex items-center gap-1.5 text-[11px] font-black uppercase tracking-wider text-red-700 dark:text-red-400 bg-red-100/70 dark:bg-red-950/50 border border-red-200 dark:border-red-800/60 px-3 py-1 rounded-full shadow-xs">
          <span>🇦🇹</span>
          TV-Programm &bull; Hauptabend
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-950 dark:text-white">
        TV-Programm heute – <span class="text-red-600 dark:text-red-400">Was spielt's im TV?</span>
      </h1>
      
      <p class="text-slate-600 dark:text-slate-400 mt-2.5 text-sm sm:text-base max-w-3xl leading-relaxed">
        <span class="font-semibold text-slate-800 dark:text-slate-200" data-live-date>{dateLabel}</span> &mdash; 
        Aktuelle Sendezeiten und Programmvorschau für den Hauptabend auf <strong>ORF 1, ORF 2, ORF III, ServusTV, ATV, PULS 4</strong> und allen beliebten Sendern.
      </p>

      <!-- Quick Switcher Navigation Pills -->
      <div class="mt-5 flex flex-wrap items-center gap-2">
        <span class="px-3.5 py-1.5 rounded-xl text-xs font-black bg-red-600 text-white shadow-xs flex items-center gap-1.5">
          <span>🇦🇹</span> Österreich Heute
        </span>
        <a href="/" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-blue-400 hover:text-blue-600 transition-colors flex items-center gap-1.5">
          <span>🇩🇪</span> Deutschland
        </a>
        <a href="/schweiz/" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-red-400 hover:text-red-600 transition-colors flex items-center gap-1.5">
          <span>🇨🇭</span> Schweiz
        </a>
        <a href="/jetzt/" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-rose-400 hover:text-rose-600 transition-colors flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 bg-rose-500 rounded-full animate-pulse"></span>
          ⚡ Jetzt live im TV
        </a>
        <a href="/20-15/" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-amber-400 hover:text-amber-600 transition-colors">
          🌙 20:15 Prime Time
        </a>
        <a href="/film-heute-abend/" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-blue-400 hover:text-blue-600 transition-colors">
          🎬 Spielfilme
        </a>
        <a href="/sport-heute-abend/" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:border-emerald-400 hover:text-emerald-600 transition-colors">
          ⚽ Sport
        </a>
      </div>

      <!-- Quick Filter Bar -->
      <div class="mt-6 pt-4 border-t border-slate-200/60 dark:border-slate-800/60 flex flex-col md:flex-row gap-3 items-stretch md:items-center justify-between">
        <!-- Live Search Input -->
        <div class="relative flex-1 max-w-md">
          <input
            id="channel-search-input"
            type="text"
            placeholder="Sender oder Sendung suchen (z. B. ORF 1, Tatort, ServusTV)..."
            class="w-full pl-9 pr-4 py-2 text-sm bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl focus:outline-hidden focus:ring-2 focus:ring-red-500 text-slate-900 dark:text-white placeholder-slate-400"
            autocomplete="off"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>

        <!-- Filter Buttons -->
        <div class="flex items-center gap-1.5 overflow-x-auto scrollbar-none py-1" id="filter-buttons">
          <button data-filter="all" class="filter-btn active px-3 py-1.5 text-xs font-semibold rounded-lg bg-red-600 text-white transition-colors">
            Alle ({channelsWithPrograms.length})
          </button>
          <button data-filter="orf" class="filter-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
            ORF Programme
          </button>
          <button data-filter="privat" class="filter-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
            Privatsender (ServusTV, ATV, PULS 4...)
          </button>
          <button data-filter="regional" class="filter-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
            Regional
          </button>
          <button data-filter="film" class="filter-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
            🎬 Filme
          </button>
          <button data-filter="sport" class="filter-btn px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
            ⚽ Sport
          </button>
        </div>
      </div>

    </div>
  </section>

  <!-- ── Top Leaderboard Ad ────────────────────────────────────────────────── -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 my-4">
    <AdSlot slot={ADSENSE_SLOTS.IN_FEED_SENDERLISTE} inFeedWrapper={true} minHeight={160} />
  </div>

  <!-- ── Main Grid ─────────────────────────────────────────────────────────── -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
    {fetchError && (
      <div class="mb-6 p-4 rounded-xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/60 text-amber-800 dark:text-amber-200 text-sm">
        <strong>Hinweis:</strong> Die Programmdaten werden momentan aktualisiert. ({fetchError})
      </div>
    )}

    {channelsWithPrograms.length === 0 && !fetchError && (
      <div class="text-center py-16 text-slate-500">
        Keine Sendungen für Österreich gefunden. Bitte versuchen Sie es in wenigen Augenblicken erneut.
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4" id="channel-grid">
      {channelsWithPrograms.map((ch) => (
        <div
          class="channel-item"
          data-channel-id={ch.slug}
          data-channel-name={ch.name.toLowerCase()}
          data-category={ch.category || ''}
          data-is-orf={ch.slug.startsWith('orf') ? 'true' : 'false'}
          data-is-privat={['servus-tv', 'atv', 'atv2', 'puls-4', 'puls-24', 'oe24-tv', 'krone-tv', 'kurier-tv', 'exxpress-tv'].includes(ch.slug) ? 'true' : 'false'}
          data-is-regional={['w24', 'r9', 'tirol-tv', 'laendle-tv', 'kt1', 'k19', 'okto', 'wntv'].includes(ch.slug) ? 'true' : 'false'}
        >
          <ChannelCard
            channel={ch}
            programs={ch.programs}
            slug={ch.slug}
            mode="abend"
          />
        </div>
      ))}
    </div>
  </main>

  <!-- ── SEO Informative Section & FAQ ──────────────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-10 mt-6 border-t border-slate-200/80 dark:border-slate-800">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Textual Guide -->
      <div class="lg:col-span-7 space-y-4 text-slate-700 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
          TV-Programm heute Abend: ORF &amp; Privatsender im Hauptabend
        </h2>
        <p>
          Mit <strong>FernsehHeute</strong> haben Sie das gesamte TV-Programm im Blick. 
          Von den verlässlichen Informationsformaten des ORF („Bundesland heute“ um 19:00, „Zeit im Bild / ZIB 1“ um 19:30, 
          „Sport aktuell“ und packende Hauptabend-Filme und Serien ab 20:15 Uhr auf <strong>ORF 1</strong> und <strong>ORF 2</strong>) 
          über niveauvolle Dokumentationen und Magazine auf <strong>ServusTV</strong> bis zu beliebten Unterhaltungsshows auf <strong>ATV</strong> und <strong>PULS 4</strong>.
        </p>
        <p>
          Darüber hinaus finden Sie bei uns auch das vollständige Tages- und Abendprogramm aller österreichischen 
          Nachrichtenkanäle (<strong>PULS 24</strong>, <strong>oe24.TV</strong>) sowie der führenden Regionalstationen (<strong>W24</strong>, 
          <strong>R9</strong>, <strong>Tirol TV</strong>, <strong>Ländle TV</strong>).
        </p>

        <!-- Highlights Table -->
        <div class="mt-6 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-slate-100 dark:bg-slate-800/80 text-slate-900 dark:text-white font-bold">
              <tr>
                <th class="p-3">Sender</th>
                <th class="p-3">Schwerpunkt</th>
                <th class="p-3">Prime-Time Beginn</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
              <tr>
                <td class="p-3 font-semibold text-slate-900 dark:text-white"><a href="/orf-2/" class="hover:text-red-600 transition-colors">ORF 2</a></td>
                <td class="p-3 text-slate-600 dark:text-slate-400">ZIB 1 &amp; ZIB 2, Bundesland heute, Kultur, Magazine, Spielfilme</td>
                <td class="p-3 font-semibold text-red-600 dark:text-red-400">20:15 Uhr</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-slate-900 dark:text-white"><a href="/orf-1/" class="hover:text-red-600 transition-colors">ORF 1</a></td>
                <td class="p-3 text-slate-600 dark:text-slate-400">Spielfilme, Serien, Live-Sport (Ski-Weltcup, Fußball, Formel 1), Comedy</td>
                <td class="p-3 font-semibold text-red-600 dark:text-red-400">20:15 Uhr</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-slate-900 dark:text-white"><a href="/servus-tv/" class="hover:text-red-600 transition-colors">ServusTV</a></td>
                <td class="p-3 text-slate-600 dark:text-slate-400">Dokumentationen (Terra Mater, Bergwelten), Heimatleuchten, Motorsport, Tennis</td>
                <td class="p-3">20:15 Uhr</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-slate-900 dark:text-white"><a href="/atv/" class="hover:text-red-600 transition-colors">ATV</a></td>
                <td class="p-3 text-slate-600 dark:text-slate-400">Bauer sucht Frau, ATV Aktuell, Reality-Formate, Hollywood-Blockbuster</td>
                <td class="p-3">20:15 Uhr</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-slate-900 dark:text-white"><a href="/puls-4/" class="hover:text-red-600 transition-colors">PULS 4</a></td>
                <td class="p-3 text-slate-600 dark:text-slate-400">2 Minuten 2 Millionen, Café Puls, Showformate, Spielfilme</td>
                <td class="p-3">20:15 Uhr</td>
              </tr>
              <tr>
                <td class="p-3 font-semibold text-slate-900 dark:text-white"><a href="/orf-iii/" class="hover:text-red-600 transition-colors">ORF III</a></td>
                <td class="p-3 text-slate-600 dark:text-slate-400">Kultur und Information, zeitgeschichtliche Dokumentationen, Oper &amp; Theater</td>
                <td class="p-3">20:15 Uhr</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ Accordion -->
      <div class="lg:col-span-5 space-y-4">
        <h3 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white mb-2">
          Häufig gestellte Fragen (FAQ)
        </h3>
        <div class="space-y-3">
          {FAQS.map((faq) => (
            <details class="group bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 p-4 transition-colors open:border-red-500/40">
              <summary class="font-semibold text-slate-900 dark:text-slate-100 cursor-pointer text-sm list-none flex items-center justify-between">
                <span>{faq.question}</span>
                <span class="text-red-500 group-open:rotate-180 transition-transform text-xs">▼</span>
              </summary>
              <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </div>

    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  // Search & Filter functionality
  const searchInput = document.getElementById('channel-search-input') as HTMLInputElement | null;
  const channelGrid = document.getElementById('channel-grid');
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');

  let activeFilter = 'all';

  function applyFilters() {
    if (!channelGrid) return;
    const q = (searchInput?.value || '').toLowerCase().trim();
    const items = channelGrid.querySelectorAll<HTMLElement>('.channel-item');

    items.forEach((item) => {
      const name = item.dataset.channelName || '';
      const id = item.dataset.channelId || '';
      const isOrf = item.dataset.isOrf === 'true';
      const isPrivat = item.dataset.isPrivat === 'true';
      const isRegional = item.dataset.isRegional === 'true';

      const matchesSearch = !q || name.includes(q) || id.includes(q);
      let matchesFilter = true;

      if (activeFilter === 'orf') matchesFilter = isOrf;
      else if (activeFilter === 'privat') matchesFilter = isPrivat;
      else if (activeFilter === 'regional') matchesFilter = isRegional;
      else if (activeFilter === 'film') {
        matchesFilter = item.textContent?.toLowerCase().includes('film') || false;
      } else if (activeFilter === 'sport') {
        matchesFilter = item.textContent?.toLowerCase().includes('sport') || isOrf;
      }

      if (matchesSearch && matchesFilter) {
        item.style.display = '';
      } else {
        item.style.display = 'none';
      }
    });
  }

  searchInput?.addEventListener('input', applyFilters);

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterButtons.forEach((b) => {
        b.classList.remove('active', 'bg-red-600', 'text-white');
        b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
      });
      btn.classList.add('active', 'bg-red-600', 'text-white');
      btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
      activeFilter = btn.dataset.filter || 'all';
      applyFilters();
    });
  });
</script>
