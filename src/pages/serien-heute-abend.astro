---
/**
 * /serien-heute-abend — Serien heute Abend im TV
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInBerlin, formatDateDE, formatTime, getBerlinHour } from '../utils/timeSlots';
import { buildHubCategoryJsonLd } from '../utils/jsonld';
import type { Program } from '../types';

const normCid = (cid: string): string =>
  cid.toLowerCase().replace(/^de-/, '').replace(/\.de$/, '');

const today = getTodayInBerlin();
const dateLabel = formatDateDE(today);

const [channels, allPrograms] = await Promise.all([
  fetchChannels(),
  fetchProgramsForDate(today),
]);

const channelName = new Map<string, string>();
const channelLogo = new Map<string, string>();
for (const ch of channels) {
  const slug = normCid(ch.id);
  channelName.set(slug, ch.name);
  channelLogo.set(slug, ch.logo);
}

const SERIES_KEYWORDS = ['serie', 'series', 'staffel', 'folge', 'episode', 'telenovela', 'soap', 'sitcom', 'krimi-serie', 'animationsserie'];
const FILM_KEYWORDS   = ['film', 'spielfilm', 'kinofilm', 'movie', 'kino', 'tv-movie', 'fernsehfilm'];

function isSeries(prog: Program): boolean {
  const genre = (prog.category ?? '').toLowerCase();
  const title = (prog.title ?? '').toLowerCase();
  const isFilm = FILM_KEYWORDS.some(k => genre.includes(k));
  if (isFilm) return false;
  return SERIES_KEYWORDS.some(k => genre.includes(k) || title.includes(k));
}

const series = allPrograms
  .filter(p => getBerlinHour(p.start_time) >= 17 && isSeries(p))
  .sort((a, b) => new Date(a.start_time).getTime() - new Date(b.start_time).getTime());

const jsonLd = buildHubCategoryJsonLd({
  categoryName: 'Serien',
  categorySlug: 'serien-heute-abend',
  programs: series,
  today,
});

const description = 'Alle Serien heute Abend im deutschen Fernsehen: Staffeln, Folgen, Sendezeiten und Sender auf einen Blick. Den richtigen Abend nie wieder verpassen.';
const keywords    = 'serien heute abend tv, was läuft heute für serien im tv, tv serien heute, serien im fernsehen heute abend, serie heute abend';
---

<BaseLayout
  title="Serien heute Abend im TV – Alle Sendungen & Zeiten | FernsehHeute"
  description={description}
  keywords={keywords}
  canonicalUrl="https://fernsehheute.de/serien-heute-abend/"
  jsonLd={jsonLd}
>
  <Header />

  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-6">

    <div class="mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">📺 Serien heute Abend im TV</h1>
      <p class="text-zinc-500 dark:text-zinc-400 mt-1">{dateLabel} · {series.length} Sendung{series.length !== 1 ? 'en' : ''}</p>
    </div>

    {series.length > 0 ? (
      <ul class="divide-y divide-slate-100 dark:divide-slate-800" role="list">
        {series.map(prog => {
          const slug = normCid(prog.channel_id ?? '');
          const name = channelName.get(slug) ?? prog.channel_id ?? '';
          const logo = channelLogo.get(slug) || '';

          const overlayJson = JSON.stringify({
            id:          prog.id,
            title:       prog.title,
            startTime:   prog.start_time,
            endTime:     prog.end_time,
            category:    prog.category ?? 'Serie',
            description: prog.description ?? '',
            poster_url:  prog.poster_url ?? null,
            cast_json:   (prog as any).cast_json ?? null,
            channelId:   slug,
            channelLogo: logo,
            channelName: name,
          });

          return (
            <li class="flex gap-4 py-3.5 hover:bg-slate-50 dark:hover:bg-slate-800/50 rounded-xl px-2.5 transition-colors group">
              <!-- Poster / Fallback Badge -->
              <div
                class="shrink-0 w-16 h-24 sm:w-20 sm:h-28 rounded-xl overflow-hidden bg-gradient-to-br from-slate-800 to-slate-900 border border-slate-200 dark:border-slate-700/80 shadow-xs flex items-center justify-center cursor-pointer group-hover:scale-105 transition-transform"
                data-program={overlayJson}
                role="button"
                tabindex="0"
                title={`${prog.title} — Details ansehen`}
              >
                {prog.poster_url ? (
                  <img
                    src={prog.poster_url}
                    alt={prog.title}
                    width="80"
                    height="112"
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                    class="w-full h-full object-cover"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                  />
                  <div class="hidden w-full h-full items-center justify-center bg-gradient-to-br from-blue-900 via-slate-900 to-slate-950 text-2xl">
                    📺
                  </div>
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-blue-900 via-slate-900 to-slate-950 text-2xl">
                    📺
                  </div>
                )}
              </div>

              <!-- Content -->
              <div class="flex-1 min-w-0 py-0.5">
                <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-0.5 mb-1">
                  <time datetime={prog.start_time} class="text-sm sm:text-base font-bold tabular-nums text-blue-600 dark:text-blue-400 shrink-0">
                    {formatTime(prog.start_time)}
                  </time>
                  <a href={`/${slug}/`} class="text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors shrink-0">
                    {name.replace(/^DE\s*-\s*/i, '')}
                  </a>
                  {prog.category && (
                    <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 border border-blue-200/60 dark:border-blue-800/40">
                      {prog.category}
                    </span>
                  )}
                </div>

                <h2
                  class="font-bold text-base sm:text-lg text-slate-900 dark:text-slate-100 leading-snug cursor-pointer group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2"
                  data-program={overlayJson}
                  role="button"
                  tabindex="0"
                >
                  {prog.title}
                </h2>

                {prog.description && (
                  <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1 line-clamp-2 leading-relaxed">
                    {prog.description}
                  </p>
                )}
              </div>

              <!-- Channel logo -->
              {logo && (
                <div class="shrink-0 hidden sm:flex items-center justify-center w-14 h-10 self-center">
                  <img
                    src={logo}
                    alt={name}
                    width="56"
                    height="40"
                    loading="lazy"
                    class="max-w-[56px] max-h-[36px] w-auto h-auto object-contain opacity-80 group-hover:opacity-100 transition-opacity"
                    onerror="this.style.display='none'"
                  />
                </div>
              )}
            </li>
          );
        })}
      </ul>
    ) : (
      <div class="text-center py-16 text-zinc-500 dark:text-zinc-400">
        <p class="text-4xl mb-4" aria-hidden="true">📺</p>
        <p class="text-lg font-medium">Keine Serien heute Abend gefunden</p>
      </div>
    )}
  </main>
  <Footer />
</BaseLayout>
