---
/**
 * /serien-heute-abend — Serien heute Abend im TV
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProgramOverlay from '../components/ProgramOverlay.astro';
import { fetchChannels, fetchProgramsForDate } from '../lib/epg';
import { getTodayInBerlin, formatDateDE, formatTime, getBerlinHour } from '../utils/timeSlots';
import { buildHubCategoryJsonLd } from '../utils/jsonld';
import { isSeries, MAIN_GERMAN_CHANNELS } from '../utils/programClassifier';
import { normCid } from '../utils/channelSlug';
import { isAdultChannel, isTestChannel, isRealProgram } from '../utils/channelFilters';
import type { Channel, Program } from '../types';

const today = getTodayInBerlin();
const dateLabel = formatDateDE(today);

const [channels, allPrograms] = await Promise.all([
  fetchChannels(),
  fetchProgramsForDate(today),
]);

const channelName = new Map<string, string>();
const channelLogo = new Map<string, string>();
for (const ch of channels) {
  const slug = normCid(ch.id);
  channelName.set(slug, ch.name);
  channelLogo.set(slug, ch.logo);
}

const series = allPrograms
  .filter(p => {
    const slug = normCid(p.channel_id ?? '');
    if (!isRealProgram(p.title)) return false;
    if (isAdultChannel(slug) || isTestChannel(slug)) return false;
    return getBerlinHour(p.start_time) >= 17 && isSeries(p);
  })
  .sort((a, b) => {
    const aSlug = normCid(a.channel_id ?? '');
    const bSlug = normCid(b.channel_id ?? '');
    const aMain = MAIN_GERMAN_CHANNELS.includes(aSlug);
    const bMain = MAIN_GERMAN_CHANNELS.includes(bSlug);

    const aHour = getBerlinHour(a.start_time);
    const bHour = getBerlinHour(b.start_time);
    const aPrime = aHour >= 20 && aHour <= 21;
    const bPrime = bHour >= 20 && bHour <= 21;

    if (aPrime && !bPrime) return -1;
    if (!aPrime && bPrime) return 1;
    if (aMain && !bMain) return -1;
    if (!aMain && bMain) return 1;
    return new Date(a.start_time).getTime() - new Date(b.start_time).getTime();
  });

function getOverlayJson(prog: Program, slug: string, logo: string, name: string): string {
  return JSON.stringify({
    id:          prog.id,
    title:       prog.title,
    startTime:   prog.start_time,
    endTime:     prog.end_time,
    category:    prog.category || 'Serie',
    description: prog.description ? prog.description.slice(0, 240) : '',
    poster_url:  prog.poster_url ?? null,
    channelId:   slug,
    channelLogo: logo,
    channelName: name,
  });
}

const jsonLd = buildHubCategoryJsonLd({
  categoryName: 'Serien',
  categorySlug: 'serien-heute-abend',
  programs: series,
  today,
});

const description = 'Alle TV-Serien heute Abend im deutschen Fernsehen: Krimiserien, US-Hits, Comedys, Staffeln und neue Folgen ab 20:15 Uhr im Überblick.';
const keywords    = 'serien heute abend tv, tv serien heute, was läuft heute für serien im tv, krimiserien heute abend, serien 20:15 im fernsehen';
const INITIAL_LIMIT = 60;
const initialSeries = series.slice(0, INITIAL_LIMIT);
const moreSeries    = series.slice(INITIAL_LIMIT);

const moreSeriesJson = JSON.stringify(moreSeries.map(prog => {
  const slug = normCid(prog.channel_id ?? '');
  const name = channelName.get(slug) ?? prog.channel_id ?? '';
  const logo = channelLogo.get(slug) || '';
  const isMain = MAIN_GERMAN_CHANNELS.includes(slug);
  const startH = getBerlinHour(prog.start_time);
  const isPrime = startH >= 20 && startH <= 21;
  const durationMin = Math.round((new Date(prog.end_time).getTime() - new Date(prog.start_time).getTime()) / 60000);

  return {
    id: prog.id,
    title: prog.title,
    startTime: prog.start_time,
    endTime: prog.end_time,
    startFormatted: formatTime(prog.start_time),
    endFormatted: formatTime(prog.end_time),
    durationMin,
    isPrime,
    category: prog.category || 'Serie',
    description: prog.description ? prog.description.slice(0, 240) : '',
    poster_url: prog.poster_url ?? '',
    channelId: slug,
    channelName: name.replace(/^DE\s*-\s*/i, ''),
    channelFullName: name,
    channelLogo: logo,
    isMain,
  };
}));
---

<BaseLayout
  title="Serien heute Abend im TV – Alle Serien & Staffeln | FernsehHeute"
  description={description}
  keywords={keywords}
  canonicalUrl="https://fernsehheute.de/serien-heute-abend/"
  jsonLd={jsonLd}
>
  <Header />

  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-6">

    <!-- Header Section -->
    <div class="mb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-5">
      <div>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/40 text-xs font-bold mb-2">
          <span>📺</span> Serien-Highlights
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
          Serien heute Abend im TV
        </h1>
        <p class="text-slate-500 dark:text-slate-400 mt-1 text-sm">
          {dateLabel} · <strong>{series.length}</strong> Serien-Episoden gefunden
        </p>
      </div>

      <!-- Quick Category Pills -->
      <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:pb-0">
        <a href="/film-heute-abend/" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors whitespace-nowrap">
          🎬 Spielfilme
        </a>
        <a href="/serien-heute-abend/" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-blue-600 text-white shadow-xs whitespace-nowrap">
          📺 Serien
        </a>
        <a href="/sport-heute-abend/" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors whitespace-nowrap">
          ⚽ Sport
        </a>
      </div>
    </div>

    {series.length > 0 ? (
      <div>
        <ul id="series-list" class="divide-y divide-slate-100 dark:divide-slate-800/80" role="list">
          {initialSeries.map(prog => {
            const slug = normCid(prog.channel_id ?? '');
            const name = channelName.get(slug) ?? prog.channel_id ?? '';
            const logo = channelLogo.get(slug) || '';
            const isMain = MAIN_GERMAN_CHANNELS.includes(slug);
            const startH = getBerlinHour(prog.start_time);
            const isPrime = startH >= 20 && startH <= 21;

            const durationMin = Math.round((new Date(prog.end_time).getTime() - new Date(prog.start_time).getTime()) / 60000);
            const overlayJson = getOverlayJson(prog, slug, logo, name);

            return (
              <li
                class="flex gap-4 py-4 hover:bg-slate-50 dark:hover:bg-slate-800/40 rounded-2xl px-3 transition-colors group cursor-pointer"
                data-program={overlayJson}
              >
                <!-- Poster / Fallback Badge -->
                <div
                  class="shrink-0 w-20 h-28 sm:w-24 sm:h-36 rounded-xl overflow-hidden bg-gradient-to-br from-slate-800 to-slate-950 border border-slate-200 dark:border-slate-700/80 shadow-sm flex items-center justify-center group-hover:scale-[1.03] group-hover:shadow-md transition-all relative"
                  title={`${prog.title} — Details ansehen`}
                >
                  {isPrime && (
                    <span class="absolute top-1 left-1 z-10 bg-blue-500 text-white text-[9px] font-black uppercase px-1.5 py-0.5 rounded shadow-xs">
                      20:15
                    </span>
                  )}
                  {prog.poster_url ? (
                    <img
                      src={prog.poster_url}
                      alt={prog.title}
                      width="96"
                      height="144"
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                      class="w-full h-full object-cover"
                      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                    />
                    <div class="hidden w-full h-full items-center justify-center bg-gradient-to-br from-blue-900 via-indigo-950 to-slate-950 text-3xl">
                      📺
                    </div>
                  ) : (
                    <div class="w-full h-full flex flex-col items-center justify-center bg-gradient-to-br from-blue-900 via-indigo-950 to-slate-950 p-2 text-center">
                      <span class="text-3xl mb-1">📺</span>
                      <span class="text-[10px] font-bold text-blue-200 line-clamp-2 leading-tight">
                        {prog.title}
                      </span>
                    </div>
                  )}
                </div>

                <!-- Content -->
                <div class="flex-1 min-w-0 py-0.5 flex flex-col justify-between">
                  <div>
                    <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 mb-1.5">
                      <time datetime={prog.start_time} class="text-base sm:text-lg font-black tabular-nums text-blue-600 dark:text-blue-400 shrink-0">
                        {formatTime(prog.start_time)}
                      </time>

                      <a
                        href={`/${slug}/`}
                        onclick="event.stopPropagation();"
                        class:list={[
                          "text-xs font-bold px-2 py-0.5 rounded-md transition-colors shrink-0",
                          isMain
                            ? "bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/40 hover:bg-blue-100"
                            : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200"
                        ]}
                      >
                        {name.replace(/^DE\s*-\s*/i, '')}
                      </a>

                      {prog.category && (
                        <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 border border-blue-200/60 dark:border-blue-800/40">
                          {prog.category}
                        </span>
                      )}

                      {durationMin > 0 && (
                        <span class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 tabular-nums">
                          ⏱ {durationMin} Min.
                        </span>
                      )}
                    </div>

                    <h2 class="font-bold text-base sm:text-xl text-slate-900 dark:text-slate-100 leading-snug group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
                      {prog.title}
                    </h2>

                    {prog.description && (
                      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-1.5 line-clamp-2 sm:line-clamp-3 leading-relaxed">
                        {prog.description}
                      </p>
                    )}
                  </div>

                  <!-- Footer meta / info button -->
                  <div class="mt-2.5 flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800/60 text-xs">
                    <span class="text-slate-400 text-[11px]">
                      Ende: {formatTime(prog.end_time)} Uhr
                    </span>
                    <span class="text-blue-600 dark:text-blue-400 font-bold group-hover:underline inline-flex items-center gap-1">
                      Folgendetails &rarr;
                    </span>
                  </div>
                </div>

                <!-- Channel logo -->
                {logo && (
                  <div class="shrink-0 hidden md:flex items-center justify-center w-16 h-12 self-start mt-2">
                    <img
                      src={logo}
                      alt={name}
                      width="64"
                      height="44"
                      loading="lazy"
                      class="max-w-[60px] max-h-[40px] w-auto h-auto object-contain opacity-85 group-hover:opacity-100 transition-opacity"
                      onerror="this.style.display='none'"
                    />
                  </div>
                )}
              </li>
            );
          })}
        </ul>

        {moreSeries.length > 0 && (
          <div id="show-more-series-wrapper" class="text-center py-8">
            <button
              id="show-more-series-btn"
              type="button"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm shadow-md transition-all active:scale-95 cursor-pointer"
            >
              <span>Alle {series.length} Serien anzeigen (+{moreSeries.length})</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </button>
          </div>
        )}

        {moreSeries.length > 0 && (
          <script id="more-series-data" type="application/json" set:html={moreSeriesJson} />
        )}
      </div>
    ) : (
      <div class="text-center py-16 text-slate-500 dark:text-slate-400">
        <p class="text-4xl mb-4" aria-hidden="true">📺</p>
        <p class="text-lg font-medium">Keine Serien für heute Abend gefunden</p>
      </div>
    )}
  </main>

  <ProgramOverlay />
  <Footer />
</BaseLayout>

<script>
  (function () {
    const btn = document.getElementById('show-more-series-btn');
    const wrapper = document.getElementById('show-more-series-wrapper');
    const list = document.getElementById('series-list');
    const dataScript = document.getElementById('more-series-data');

    if (!btn || !list || !dataScript) return;

    btn.addEventListener('click', () => {
      try {
        const items = JSON.parse(dataScript.textContent || '[]');
        let html = '';
        for (const item of items) {
          const overlayData = JSON.stringify({
            id: item.id,
            title: item.title,
            startTime: item.startTime,
            endTime: item.endTime,
            category: item.category,
            description: item.description,
            poster_url: item.poster_url || null,
            channelId: item.channelId,
            channelLogo: item.channelLogo,
            channelName: item.channelFullName,
          });

          html += `
<li
  class="flex gap-4 py-4 hover:bg-slate-50 dark:hover:bg-slate-800/40 rounded-2xl px-3 transition-colors group cursor-pointer"
  data-program='${overlayData.replace(/'/g, "&#39;")}'
>
  <div
    class="shrink-0 w-20 h-28 sm:w-24 sm:h-36 rounded-xl overflow-hidden bg-gradient-to-br from-slate-800 to-slate-950 border border-slate-200 dark:border-slate-700/80 shadow-sm flex items-center justify-center group-hover:scale-[1.03] group-hover:shadow-md transition-all relative"
    title="${item.title} — Details ansehen"
  >
    ${item.isPrime ? '<span class="absolute top-1 left-1 z-10 bg-blue-500 text-white text-[9px] font-black uppercase px-1.5 py-0.5 rounded shadow-xs">20:15</span>' : ''}
    ${item.poster_url ? `
      <img
        src="${item.poster_url}"
        alt="${item.title}"
        width="96"
        height="144"
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        class="w-full h-full object-cover"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
      />
      <div class="hidden w-full h-full items-center justify-center bg-gradient-to-br from-blue-900 via-indigo-950 to-slate-950 text-3xl">📺</div>
    ` : `
      <div class="w-full h-full flex flex-col items-center justify-center bg-gradient-to-br from-blue-900 via-indigo-950 to-slate-950 p-2 text-center">
        <span class="text-3xl mb-1">📺</span>
        <span class="text-[10px] font-bold text-blue-200 line-clamp-2 leading-tight">${item.title}</span>
      </div>
    `}
  </div>
  <div class="flex-1 min-w-0 py-0.5 flex flex-col justify-between">
    <div>
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 mb-1.5">
        <time datetime="${item.startTime}" class="text-base sm:text-lg font-black tabular-nums text-blue-600 dark:text-blue-400 shrink-0">
          ${item.startFormatted}
        </time>
        <a
          href="/${item.channelId}/"
          onclick="event.stopPropagation();"
          class="text-xs font-bold px-2 py-0.5 rounded-md transition-colors shrink-0 ${item.isMain ? 'bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/40 hover:bg-blue-100' : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200'}"
        >
          ${item.channelName}
        </a>
        ${item.category ? `<span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 border border-blue-200/60 dark:border-blue-800/40">${item.category}</span>` : ''}
        ${item.durationMin > 0 ? `<span class="text-[11px] font-semibold text-slate-400 dark:text-slate-500 tabular-nums">⏱ ${item.durationMin} Min.</span>` : ''}
      </div>
      <h2 class="font-bold text-base sm:text-xl text-slate-900 dark:text-slate-100 leading-snug group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
        ${item.title}
      </h2>
      ${item.description ? `<p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-1.5 line-clamp-2 sm:line-clamp-3 leading-relaxed">${item.description}</p>` : ''}
    </div>
    <div class="mt-2.5 flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800/60 text-xs">
      <span class="text-slate-400 text-[11px]">Ende: ${item.endFormatted} Uhr</span>
      <span class="text-blue-600 dark:text-blue-400 font-bold group-hover:underline inline-flex items-center gap-1">Folgendetails &rarr;</span>
    </div>
  </div>
  ${item.channelLogo ? `
    <div class="shrink-0 hidden md:flex items-center justify-center w-16 h-12 self-start mt-2">
      <img src="${item.channelLogo}" alt="${item.channelFullName}" width="64" height="44" loading="lazy" class="max-w-[60px] max-h-[40px] w-auto h-auto object-contain opacity-85 group-hover:opacity-100 transition-opacity" onerror="this.style.display='none'" />
    </div>
  ` : ''}
</li>`;
        }
        list.insertAdjacentHTML('beforeend', html);
        if (wrapper) wrapper.style.display = 'none';
      } catch (e) {
        console.error('Error rendering more series', e);
      }
    });
  })();
</script>
